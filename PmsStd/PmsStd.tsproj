		<DataType>
			<Name GUID="{024A6375-CC4F-1984-E42B-D7B9E267EBC2}" AutoDeleteType="true">ST_SourceReg</Name>
			<BitSize>224</BitSize>
			<SubItem>
				<Name>bEnable</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<BitSize>8</BitSize>
				<BitOffs>0</BitOffs>
			</SubItem>
			<SubItem>
				<Name>nGrade</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000005}">UINT</Type>
				<Comment><![CDATA[ 등급. 1이 가장 높음]]></Comment>
				<BitSize>16</BitSize>
				<BitOffs>16</BitOffs>
				<Default>
					<Value>9</Value>
				</Default>
			</SubItem>
			<SubItem>
				<Name>stStateMode</Name>
				<Type GUID="{84201F4F-6679-2938-BD14-4FAFC26089BB}">ST_StateModeSet</Type>
				<Comment><![CDATA[ 상태 요청을 명령마다 어느 운전 모드에서 받나 (기본 모두 Manual). 리셋은 모드와 관계없이 받음]]></Comment>
				<BitSize>96</BitSize>
				<BitOffs>32</BitOffs>
			</SubItem>
			<SubItem>
				<Name>ePowerMode</Name>
				<Type GUID="{008CBD37-337B-FCFE-DB78-1E8CF10FFBB0}">E_SourceMode</Type>
				<Comment><![CDATA[ P·Q 지령과 P 제한을 받는 운전 모드]]></Comment>
				<BitSize>16</BitSize>
				<BitOffs>128</BitOffs>
				<Default>
					<EnumText>E_SourceMode.Auto</EnumText>
				</Default>
			</SubItem>
			<SubItem>
				<Name>nGroup</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000005}">UINT</Type>
				<Comment><![CDATA[ 대상 제어 그룹. 0 = 모든 그룹]]></Comment>
				<BitSize>16</BitSize>
				<BitOffs>144</BitOffs>
			</SubItem>
			<SubItem>
				<Name>tExpire</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000048}">TIME</Type>
				<Comment><![CDATA[ 이 시간 동안 새 값이 없으면 끊김]]></Comment>
				<BitSize>32</BitSize>
				<BitOffs>160</BitOffs>
				<Default>
					<DateTime>T#10S</DateTime>
				</Default>
			</SubItem>
			<SubItem>
				<Name>bLostAlarm</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[ 끊기면 '지령원 끊김' 알람 (FB_EventLog). FALSE = 알람 안 냄 (끊김 처리는 그대로). [9번 수정 2026-11-09: 추가 — EMS는 브로커 끊김 알람으로 대신]]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>192</BitOffs>
				<Default>
					<Bool>true</Bool>
				</Default>
			</SubItem>
		</DataType>
		<DataType>
			<Name GUID="{B44FD61D-FBE8-B2DC-0718-EBED4C00DE54}" AutoDeleteType="true">ST_ModuleReg</Name>
			<BitSize>48</BitSize>
			<SubItem>
				<Name>bEnable</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<BitSize>8</BitSize>
				<BitOffs>0</BitOffs>
				<Default>
					<Bool>true</Bool>
				</Default>
			</SubItem>
			<SubItem>
				<Name>nGroup</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000005}">UINT</Type>
				<Comment><![CDATA[ 대상 제어 그룹. 0 = 모든 그룹 (제한·보정·기동 조건은 그룹이 1개일 때만. 2개 이상이면 그룹마다 인스턴스)]]></Comment>
				<BitSize>16</BitSize>
				<BitOffs>16</BitOffs>
			</SubItem>
			<SubItem>
				<Name>bManual</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[ 출력 제한 모듈만: 접속점 기준 모듈을 Manual 경로에도 적용 (Auto는 항상 적용)]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>32</BitOffs>
			</SubItem>
		</DataType>
		<DataType>
			<Name GUID="{EF85E0D1-A7E8-AFF0-3BD2-D97943C060FE}" AutoDeleteType="true">E_PcsAction</Name>
			<BitSize>16</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000006}">INT</BaseType>
			<EnumInfo>
				<Text><![CDATA[None]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[ 조치 없음 (알람만), 자동 해제]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Standby]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[ 대기 = 출력 0 (명령 없음: 가용 아님으로 출력에서 빠짐). 조건이 있는 동안만, 풀리면 다시 출력]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Stop]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[ 정지 명령. 조건이 풀려도 정지 유지 (다시 운전하려면 Run)]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[EStop]]></Text>
				<Enum>3</Enum>
				<Comment><![CDATA[ 비상정지. 위와 같음]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>qualified_only</Name>
				</Property>
				<Property>
					<Name>strict</Name>
				</Property>
				<Property>
					<Name>generate_implicit_init_function</Name>
				</Property>
			</Properties>
		</DataType>
		<DataType>
			<Name GUID="{B70AD360-617A-FF0A-EE7F-CEEC7F477513}" AutoDeleteType="true">E_BatAction</Name>
			<BitSize>16</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000006}">INT</BaseType>
			<EnumInfo>
				<Text><![CDATA[None]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[ 조치 없음]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Stop]]></Text>
				<Enum>1</Enum>
