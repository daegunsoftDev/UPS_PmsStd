		<DataType>
			<Name GUID="{D6BB80EE-4667-8CE4-DE19-F3C36ED88BB8}" AutoDeleteType="true">ST_GroupSet</Name>
			<BitSize>224</BitSize>
			<SubItem>
				<Name>eSelP</Name>
				<Type GUID="{EE6FE45B-FEBD-F760-7DC4-4AE73E1D47B0}">E_SelectMode</Type>
				<Comment><![CDATA[ 그룹 P 지령원 고르는 방식]]></Comment>
				<BitSize>16</BitSize>
				<BitOffs>0</BitOffs>
			</SubItem>
			<SubItem>
				<Name>eSelQ</Name>
				<Type GUID="{EE6FE45B-FEBD-F760-7DC4-4AE73E1D47B0}">E_SelectMode</Type>
				<Comment><![CDATA[ 그룹 Q 지령원 고르는 방식]]></Comment>
				<BitSize>16</BitSize>
				<BitOffs>16</BitOffs>
			</SubItem>
			<SubItem>
				<Name>bRamp</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[ 램프 사용 (Auto·Manual 공통). FALSE = 램프율과 관계없이 바로 목표 (기본)]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>32</BitOffs>
			</SubItem>
			<SubItem>
				<Name>fRampUp</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000D}">REAL</Type>
				<Comment><![CDATA[ kW/s, |P|가 커지는 쪽. 0 = 램프 없음]]></Comment>
				<BitSize>32</BitSize>
				<BitOffs>64</BitOffs>
			</SubItem>
			<SubItem>
				<Name>fRampDn</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000D}">REAL</Type>
				<Comment><![CDATA[ kW/s, |P|가 작아지는 쪽. 0 = 램프 없음]]></Comment>
				<BitSize>32</BitSize>
				<BitOffs>96</BitOffs>
			</SubItem>
			<SubItem>
				<Name>fRampResume</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000D}">REAL</Type>
				<Comment><![CDATA[ kW/s, 제한 모듈이 재개 중일 때 오르는 쪽. 0 = fRampUp 사용]]></Comment>
				<BitSize>32</BitSize>
				<BitOffs>128</BitOffs>
			</SubItem>
			<SubItem>
				<Name>tQFilter</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000048}">TIME</Type>
				<Comment><![CDATA[ Q 응답 필터 시정수. T#0S = 필터 없음]]></Comment>
				<BitSize>32</BitSize>
				<BitOffs>160</BitOffs>
			</SubItem>
			<SubItem>
				<Name>eDistBasis</Name>
				<Type GUID="{426BC792-990D-2B59-F749-4611D8DB4D39}">E_DistBasis</Type>
				<Comment><![CDATA[ 그룹 몫 나누는 기준]]></Comment>
				<BitSize>16</BitSize>
				<BitOffs>192</BitOffs>
			</SubItem>
			<SubItem>
				<Name>bQPriority</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[ 피상전력 초과 시 TRUE = Q 우선, FALSE = P 우선]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>208</BitOffs>
			</SubItem>
		</DataType>
		<DataType>
			<Name GUID="{EF0C9602-234E-BC7C-29F4-12CB339BEA74}" AutoDeleteType="true">ST_ManualPolicy</Name>
			<BitSize>56</BitSize>
			<SubItem>
				<Name>bRamp</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[ P 램프·Q 응답 필터 (그룹 설정 bRamp·tQFilter를 따름)]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>0</BitOffs>
				<Default>
					<Bool>true</Bool>
				</Default>
			</SubItem>
			<SubItem>
				<Name>bSrcLimit</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[ 지령원이 낸 P 제한]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>8</BitOffs>
				<Default>
					<Bool>true</Bool>
				</Default>
			</SubItem>
			<SubItem>
				<Name>bPccLimit</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[ 접속점 기준 제한 모듈 (모듈 등록의 bManual = TRUE인 것만)]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>16</BitOffs>
				<Default>
					<Bool>true</Bool>
				</Default>
			</SubItem>
			<SubItem>
				<Name>bComp</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[ 보정 (같은 그룹에 Auto 유닛이 있으면 Auto 쪽에만 더함: 두 번 더하지 않게)]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>24</BitOffs>
				<Default>
					<Bool>false</Bool>
				</Default>
			</SubItem>
			<SubItem>
				<Name>bDevLimit</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[ 설비 기준 제한 모듈 (P·Q)]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>32</BitOffs>
				<Default>
					<Bool>true</Bool>
				</Default>
			</SubItem>
			<SubItem>
				<Name>bRating</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[ 유닛 정격·Derate·피상전력]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>40</BitOffs>
				<Default>
					<Bool>true</Bool>
				</Default>
			</SubItem>
			<SubItem>
				<Name>bBatLimit</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[ BMS 충방전 한도 (유닛·배터리 버스)]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>48</BitOffs>
				<Default>
					<Bool>true</Bool>
				</Default>
			</SubItem>
		</DataType>
