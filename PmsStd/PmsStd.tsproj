			<BaseType GUID="{18071995-0000-0000-0000-000000000006}">INT</BaseType>
			<EnumInfo>
				<Text><![CDATA[Auto]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[ 자동: 원격·자동 지령원이 동작]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Manual]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[ 수동: 수동 지령원만 동작]]></Comment>
