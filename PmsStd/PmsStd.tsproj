				<Enum>0</Enum>
				<Comment><![CDATA[ 등급 우선 (등급 숫자가 작은 지령원)]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[MinAbs]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[ 절대값이 가장 작은 값]]></Comment>
			</EnumInfo>
			<Properties>
