<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <GVL Name="GVL_IF" Id="{bedeb546-f568-47b1-b133-e1b0bec44a1a}">
    <Declaration><![CDATA[VAR_GLOBAL
	g_nUpsConfigSeq : UDINT; // MqttTask writer, PlcTask reader; odd=in progress
	g_stUpsConfigRx : ST_IfUpsConfigRx;
	g_nUpsCmdSeq : UDINT; // UPS 명령 칸 번호. PRG_Mqtt(MqttTask)가 쓰고 MAIN(PlcTask)이 읽음. 홀수 = 쓰는 중
	g_astUpsCmd : ARRAY[1..GVL_PARAM.UPS_COUNT] OF ST_IfUpsCmd; // UPS별 마지막 명령 (번호가 바뀌면 새 명령)
	(* ================================================================
	   태스크 사이에 주고받는 값 (자리만. 내용은 인터페이스가 정해지면 채움)

	   규칙
	   - 칸마다 쓰는 태스크는 하나. 다른 태스크는 읽기만
	   - 쓰는 쪽: 쓰기 전에 번호(…Seq)를 1 올리고(홀수 = 쓰는 중), 내용을 다 쓴 뒤 다시 1 올림(짝수 = 끝)
	   - 읽는 쪽: 번호 읽기(짝수일 때만) → 내용 복사 → 번호 다시 읽기. 두 번호가 같을 때만 새 값으로 씀
	     (쓰는 도중에 읽어 반만 바뀐 값을 쓰지 않게. 우선순위가 높은 태스크가 쓰는 중에 끼어들어도 읽는 쪽이 걸러냄.
	      내용 쪽에도 …RxCount·nSeq 같은 번호를 두어 새 값인지는 그 번호로 가림)
	   - 제어 흐름(읽기 → 보호 → 요청 → 중재 → 분배 → 쓰기)은 PlcTask의 MAIN에만 둔다
	   - 태스크 전용 FB 인스턴스는 그 태스크 PRG 안에 선언한다. I/O 연결이 있는 인스턴스를 GVL에 두면
	     {attribute 'TcContextName' := '태스크 이름'}을 붙여야 그 태스크 주기로 I/O가 갱신된다 (기본은 PlcTask)
	   ================================================================ *)

	(* ---------- MAIN → MQTT: 보고 (쓰는 곳: MAIN의 FB_Report) ---------- *)
	g_nReportSeq		: UDINT;		// 보고 칸 번호 (홀수 = 쓰는 중, 짝수 = 끝). MAIN 액션 A_Report가 씀
	g_stReport			: ST_IfReport;	// 발행 직전 PCS 레코드 (보고 매핑 모듈 결과). PRG_Mqtt가 복사해 GVL_MQTT.g_stPcsPublish에 채움

	(* ---------- MQTT → MAIN: 명령 (쓰는 곳: PRG_Mqtt) ---------- *)
	g_nCmdSeq			: UDINT;		// 명령 칸 번호 (홀수 = 쓰는 중, 짝수 = 끝). PRG_Mqtt가 씀
	g_stEmsCmd			: ST_IfEmsCmd;	// EMS 명령: PCS·BMS 상태 명령과 충전·방전 P. PRG_Mqtt(FB_EmsCommand 결과)가 씀. MAIN 액션 A_PassEmsCmd가 복사해 지령원 FB_SrcEms에 넘김
	(* ---------- MQTT → MAIN: EMS config (쓰는 곳: PRG_Mqtt) [9-21 수정 2026-11-04: 추가] ---------- *)
	g_nCfgSeq			: UDINT;		// config 칸 번호 (홀수 = 쓰는 중, 짝수 = 끝). PRG_Mqtt가 씀
	g_stEmsCfg			: ST_IfEmsCfg;	// 받은 config 레코드(pcs·bat) + 칸마다 번호. MAIN 액션 A_PassEmsCfg가 복사해 FB_EmsConfigApply에 넘김
	(* ---------- MAIN → MQTT: config echo (쓰는 곳: MAIN) [9-21 수정 2026-11-04: 추가] ---------- *)
	g_nCfgEchoSeq		: UDINT;		// echo 칸 번호 (홀수 = 쓰는 중, 짝수 = 끝)
	g_stEmsCfgEcho		: ST_IfEmsCfgEcho;	// 실제 설정 (설정 보호 뒤). PRG_Mqtt가 복사해 config echo로 발행

	(* ---------- MQTT → MAIN: 브로커 접속 상태 (쓰는 곳: PRG_Mqtt) [9번 수정 2026-11-09: 추가]. 칸 1 Cloud, 2 Local, 3 Azure ---------- *)
	g_abBrokerUse		: ARRAY[1..3] OF BOOL;	// 쓰는 브로커 (GVL_SITE.MQTT_SET bUse)
	g_abBrokerConn		: ARRAY[1..3] OF BOOL;	// 구독 클라이언트가 브로커에 접속됨 (command·config를 받는 쪽)

	(* ---------- 빠른 계측 → MAIN (쓰는 곳: PRG_Fast) ---------- *)
	g_nFastSeq			: UDINT;		// 계측값을 다 쓴 뒤 올림. MAIN 쪽 계측기 드라이버가 읽음
	// 계측값 자리

	(* ---------- 이중화 (쓰는 곳: PRG_Redundancy) ---------- *)
	g_eRedRole			: E_RedRole;	// 이 PLC의 역할 (Primary/Secondary). 이중화를 안 쓰면 Primary
	g_bRedActive		: BOOL := NOT GVL_SITE.RED_SET.bUse;	// 이 PLC가 지금 장비에 쓰는가 (Active). 이중화를 안 쓰면 항상 TRUE, 쓰면 역할이 정해질 때까지 FALSE
	g_nRedSeq			: UDINT;		// 보낸 하트비트 수 (FB_RedLink)
	g_ePeerState		: E_RedPeer;	// 상대 PLC 상태 (EAP 하트비트 + 접점). 이중화를 안 쓰면 Unknown
	g_bPeerEapOk		: BOOL;			// EAP 하트비트 정상
	g_bPeerWireOk		: BOOL;			// 접점(alive) 신호 정상
	g_nPeerRole			: INT;			// 상대가 보낸 역할 (E_RedRole). EAP 정상일 때만 유효
	g_bPeerActive		: BOOL;			// 상대가 보낸 Active (EAP)
	g_bPeerWireActive	: BOOL;			// 상대 Active 접점 (EAP와 따로 봄)
	g_eRedState			: E_RedState;	// 이 PLC의 이중화 상태 (Init/Standby/Active/Failed). g_bRedActive는 이 상태가 Active인 것
	g_bRedRoleConflict	: BOOL;			// 두 PLC가 같은 역할 (설정 오류)
	g_bRedWrite			: BOOL := NOT GVL_SITE.RED_SET.bUse;	// 장비에 써도 됨 = Active가 된 뒤 tWriteHold 지남 (MAIN의 bWriteEnable이 봄). 이중화를 안 쓰면 항상 TRUE
	g_nPeerState		: INT;			// 상대가 보낸 이중화 상태 (E_RedState). EAP 정상일 때만 유효
	g_bSyncInSync		: BOOL;			// 상대 Active의 설정과 내 설정이 같음 (내가 Active가 아닐 때만 TRUE). 복귀 조건
	g_bSyncFresh		: BOOL;			// 상대가 보낸 동기화 값이 낡지 않음
	g_nSyncApplied		: UDINT;		// 상대 값으로 내 설정 블록을 덮어쓴 횟수
	g_nRedResumeCount	: UDINT;		// PLC가 멈췄다 이어진 횟수 (이 때 이중화 상태를 Init부터 다시 정함)
	g_nRedSwitchCount	: UDINT;		// Active가 바뀐 횟수 (들어가거나 나옴)
	g_eRedSwitch		: E_RedSwitch;	// Active가 바뀐 마지막 이유 (None/Start/PeerLost/Failback/Yield)
	// 동기화할 값 자리
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>