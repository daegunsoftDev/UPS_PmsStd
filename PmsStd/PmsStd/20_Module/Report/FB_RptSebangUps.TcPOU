<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_RptSebangUps" Id="{25f647f2-af7c-4a94-847f-4917f8e29aa9}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_RptSebangUps // UPS 계측값 → UPS 보고값
VAR_INPUT
 i_stState : ST_UpsState; // 장비 상태
 i_nDeviceIndex : UDINT; // UPS 번호
END_VAR
VAR_OUTPUT
 q_stUps : ST_UpsPublish_V1; // UPS 보고값
 q_bValid : BOOL; // 유효한 장비 데이터
END_VAR
VAR
 _stEmpty : ST_UpsPublish_V1;
 _awWarn : ARRAY[0..7] OF WORD; // 워드별 경고장 비트 (I44~I51)
 _awFault : ARRAY[0..7] OF WORD; // 워드별 중고장 비트 (I44~I51)
 _i : INT;
END_VAR
VAR CONSTANT
 // 세방 맵 v3.2 Alarm Flag 색. 순서 = I44 입력, I45 정류부, I46 BBC, I47 출력, I48 인버터, I49 바이패스, I50 STATUS1, I51 STATUS2
 WARN_MASK : ARRAY[0..7] OF WORD := [16#0700, 16#0003, 16#0007, 16#00FF, 16#0000, 16#03FF, 16#0000, 16#0701]; // 경고장(노랑)
 FAULT_MASK : ARRAY[0..7] OF WORD := [16#F8FF, 16#667C, 16#0FB8, 16#3F00, 16#803F, 16#0000, 16#0081, 16#7800]; // 중고장(주황)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[q_stUps := _stEmpty;
q_stUps.DeviceIndex := i_nDeviceIndex;
q_stUps.Status := 1; // b0 통신에러
q_bValid := i_stState.bValid;
IF NOT q_bValid THEN
 RETURN;
END_IF

// 명세 RD-UPS-02 (v1.6): 경고장·중고장 마스크로 거르고 나머지 상태 비트는 버림. 한 칸 = 워드 2개 (하위 16비트 + 상위 16비트), 비트 위치는 맵 그대로
// 칸 1·2 = I44·I45, I46·I47. 칸 3은 빈 반쪽에 STATUS 워드를 채움:
//   Warning3 = 하위 I51 경고 (I48은 경고 비트 없음) / 상위 I49 경고
//   Fault3   = 하위 I48 고장 / 상위 I50 고장 OR I51 고장 (I49는 고장 비트 없음. I50 b0·b7과 I51 b11~14는 겹치지 않음)
// 마스크를 바꿔 I48 경고·I49 고장·I50 경고가 생기면 이 배치를 다시 정해야 함
FOR _i := 0 TO 7 DO
 _awWarn[_i] := i_stState.awAlarmStatus[_i] AND WARN_MASK[_i];
 _awFault[_i] := i_stState.awAlarmStatus[_i] AND FAULT_MASK[_i];
END_FOR
q_stUps.Warning1 := WORD_TO_UDINT(_awWarn[0]) OR SHL(WORD_TO_UDINT(_awWarn[1]), 16);
q_stUps.Warning2 := WORD_TO_UDINT(_awWarn[2]) OR SHL(WORD_TO_UDINT(_awWarn[3]), 16);
q_stUps.Warning3 := WORD_TO_UDINT(_awWarn[7]) OR SHL(WORD_TO_UDINT(_awWarn[5]), 16);
q_stUps.Fault1 := WORD_TO_UDINT(_awFault[0]) OR SHL(WORD_TO_UDINT(_awFault[1]), 16);
q_stUps.Fault2 := WORD_TO_UDINT(_awFault[2]) OR SHL(WORD_TO_UDINT(_awFault[3]), 16);
q_stUps.Fault3 := WORD_TO_UDINT(_awFault[4]) OR SHL(WORD_TO_UDINT(_awFault[6] OR _awFault[7]), 16);

// 명세 RD-UPS-01: Status
q_stUps.Status := 0;
q_stUps.Status.1 := i_stState.bInverterOn; // run
q_stUps.Status.2 := NOT i_stState.bInverterOn; // stop
q_stUps.Status.3 := i_stState.bOnBypass; // bypass 운전
q_stUps.Status.4 := i_stState.bOnInverter; // inverter 운전
q_stUps.Status.5 := (q_stUps.Warning1 OR q_stUps.Warning2 OR q_stUps.Warning3) <> 0; // 경고 있음
q_stUps.Status.6 := (q_stUps.Fault1 OR q_stUps.Fault2 OR q_stUps.Fault3) <> 0; // 고장 있음
q_stUps.Status.7 := i_stState.bEmergencyStop; // e-stop
q_stUps.Status.8 := i_stState.wStatus1.5; // 수동 바이패스(MBS C/B close)
q_stUps.Status.9 := i_stState.wStatus1.6; // 출력 차단기 개방(Out C/B Open)
q_stUps.Status.10 := i_stState.bBbcOn; // BBC 기동 (I46 b12)
q_stUps.Status.11 := i_stState.nBatMode = 0; // 부동충전 (BAT Mode 값을 비트로 나눔)
q_stUps.Status.12 := i_stState.nBatMode = 1; // 균등충전
q_stUps.Status.13 := i_stState.nBatMode = 2; // 대기
q_stUps.Status.14 := i_stState.nBatMode = 3; // 주기적 방전
q_stUps.Status.15 := i_stState.nBatMode = 4; // 펄스 방전
q_stUps.Status.16 := i_stState.nBatMode = 5; // 간헐충전
q_stUps.Status.17 := i_stState.bTemperatureEnabled; // 온도보상충전 (I51 b2, 다른 모드와 동시 가능)

q_stUps.LineInputVoltage_R := i_stState.fInputVoltageRV;
q_stUps.LineInputVoltage_S := i_stState.fInputVoltageSV;
q_stUps.LineInputVoltage_T := i_stState.fInputVoltageTV;
q_stUps.InputFrequency := i_stState.fInputFrequencyHz;
q_stUps.InputCurrent_R := i_stState.fInputCurrentRA;
q_stUps.InputCurrent_S := i_stState.fInputCurrentSA;
q_stUps.InputCurrent_T := i_stState.fInputCurrentTA;
q_stUps.InverterVoltage_R := i_stState.fInverterVoltageRV;
q_stUps.InverterVoltage_S := i_stState.fInverterVoltageSV;
q_stUps.InverterVoltage_T := i_stState.fInverterVoltageTV;
q_stUps.InverterCurrent_R := i_stState.fInverterCurrentRA;
q_stUps.InverterCurrent_S := i_stState.fInverterCurrentSA;
q_stUps.InverterCurrent_T := i_stState.fInverterCurrentTA;
q_stUps.BypassLineVoltage_R := i_stState.fBypassVoltageRV;
q_stUps.BypassLineVoltage_S := i_stState.fBypassVoltageSV;
q_stUps.BypassLineVoltage_T := i_stState.fBypassVoltageTV;
q_stUps.BypassFrequency := i_stState.fBypassFrequencyHz;
q_stUps.LineOutputVoltage_R := i_stState.fOutputVoltageRV;
q_stUps.LineOutputVoltage_S := i_stState.fOutputVoltageSV;
q_stUps.LineOutputVoltage_T := i_stState.fOutputVoltageTV;
q_stUps.FrequencyOutput := i_stState.fOutputFrequencyHz;
q_stUps.OutputCurrent_R := i_stState.fOutputCurrentRA;
q_stUps.OutputCurrent_S := i_stState.fOutputCurrentSA;
q_stUps.OutputCurrent_T := i_stState.fOutputCurrentTA;
q_stUps.DcLinkVoltage := i_stState.fDcLinkVoltageV;
q_stUps.DcLinkVoltage_High := i_stState.fDcLinkHighVoltageV;
q_stUps.DcLinkVoltage_Low := i_stState.fDcLinkLowVoltageV;
q_stUps.BatteryVoltage := i_stState.fBatteryVoltageV;
q_stUps.BatteryCurrent := i_stState.fBatteryCurrentA;
q_stUps.MPI_A_Current := i_stState.fMpiCurrentAA;
q_stUps.MPI_B_Current := i_stState.fMpiCurrentBA;
q_stUps.MPI_C_Current := i_stState.fMpiCurrentCA;
q_stUps.InputApparentPower := i_stState.fInputApparentPowerKva;
q_stUps.OutputApparentPower := i_stState.fOutputApparentPowerKva;
q_stUps.OutputActivePower := i_stState.fOutputActivePowerKw;
q_stUps.Temp1 := i_stState.fTemperature1C;
q_stUps.Temp2 := i_stState.fTemperature2C;
q_stUps.Temp3 := i_stState.fTemperature3C;
q_stUps.Temp4 := i_stState.fTemperature4C;
q_stUps.Temp5 := i_stState.fTemperature5C;
q_stUps.Temp6 := i_stState.fBatteryRoomTemperatureC;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
