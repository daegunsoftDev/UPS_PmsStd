<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
<DUT Name="E_UpsChargeAction" Id="{312450c0-1155-4d59-b74b-4a25dd52a9f9}"><Declaration><![CDATA[// 충방전 시퀀스가 요청하는 동작. ST_UpsChargeRequest.eAction에 담긴다.
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_UpsChargeAction : (
 NoRequest := 0, // 요청 없음
 BbcOn := 1, // BBC 기동
 BbcReady := 2, // BBC 대기 (현재 맵에 명령 없음, 확인 필요)
 BmsPreparePeriodic := 3, // BMS 주기적 방전 준비
 BmsPreparePulse := 4, // BMS 펄스 방전 준비
 PeriodicStart := 5, // UPS 주기적 방전 시작
 PulseStart := 6, // UPS 펄스 방전 시작
 DischargeCancel := 7, // UPS 방전 취소
 BmsDischargeCancel := 8, // BMS 방전 취소
 FloatCharge := 9, // 부동충전 복귀
 ChargeVoltage := 10 // 충전 전압 적용 (온도보상, fValue 사용)
) INT;
END_TYPE]]></Declaration></DUT>
</TcPlcObject>
