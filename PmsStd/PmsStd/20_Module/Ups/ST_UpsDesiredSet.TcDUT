<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_UpsDesiredSet" Id="{7a9bea49-ee5e-4b5c-8243-61b925bf1897}">
    <Declaration><![CDATA[(* UPS 1대에 맞춰 둘 설정 보관값 (장치: UPS). 2026-11-05.
   기반 없음(신규). GVL_PERSIST.g_astUpsDesired에 두어 PMS 재시작 후에도 남는다.
   명세: C:\gil\UPS\명세서\UPS_명세서.md CF-UPS-02·03
   칸 0~6 = UPS Holding H50~H56 (FB_UpsConfigApply의 쓰기 대상과 같은 순서)
   bTempCompOn·bTrickleOn = 시작·정지 명령으로 정한 켜짐 상태 (FB_UpsCommand가 씀, 2026-11-05 추가) *)
TYPE ST_UpsDesiredSet :
STRUCT
	bValid		: BOOL;							// 한 번이라도 EMS 설정을 받아 보관함
	abUse		: ARRAY[0..6] OF BOOL;			// 이 칸을 맞출지 (EMS is_available)
	awValue		: ARRAY[0..6] OF WORD;			// 맞출 원시값 (UPS 레지스터 값 그대로)
	nRxCount	: UDINT;						// 보관한 설정의 수신 누계 (참고용)
	bTempCompOn	: BOOL;							// 온도보상충전을 켜 둬야 함 (명령 4 → TRUE, 8 → FALSE)
	bTrickleOn	: BOOL;							// 간헐충전을 켜 둬야 함 (명령 1 → TRUE, 7 → FALSE). UPS 상태로 확인할 칸이 없어 복구는 하지 않음
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>