<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_UpsConfigApply" Id="{4e08e92f-3455-48e2-9428-4f5d2d75fec4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_UpsConfigApply // EMS config/ups → UPS Holding 설정 쓰기
(* EMS가 내린 주기적·펄스 방전 설정을 UPS에 쓰고 되읽어 확인한다 (UPS 설정). 2026-11-02.
   기반 없음(신규).
   대상: H50~H56만. 간헐충전·온도보상 필드는 실행 주체·형식 미확정이라 쓰지 않는다.
   - 값 하나라도 범위 밖이면 그 UPS의 이번 설정 전체를 버린다 (BadConfig).
   - is_available=0인 필드와 현재 값이 같은 필드는 쓰지 않는다.
   - BAT Mode가 0(부동충전)일 때만 쓴다. 다른 운전 중이면 끝날 때까지 기다린다.
   - 쓰기 금지 상태에서 받은 설정은 적용하지 않고 버린다 (Disabled). 나중에 허용돼도 옛 값을 쓰지 않음.
   단위: 전류 A → 0.1A, 시간 분·초, 횟수 Cycle. EMS 쪽 단위는 확인 필요.
   2026-11-05 (명세 CF-UPS-02·03): 받은 설정을 보관값(iq_stDesired, GVL_PERSIST)에 남기고,
   i_tRecheck마다 UPS 값을 되읽어 보관값과 다르면 다시 쓴다 (UPS 재기동·PMS 재시작·통신 복구 후 복구).
   UPS 고장(i_bUpsFault)·e-stop 중에는 쓰지 않는다. 쓰기가 i_nMaxFail회 연속 실패하면 q_bMismatch를 켜고
   새 설정을 받을 때까지 복구를 멈춘다. *)
VAR_INPUT
 i_bEnable : BOOL; // 장비 쓰기 허용
 i_nRxCount : UDINT; // config/ups 수신 누계
 i_stConfig : ST_UpsConfig_Rx; // 이 UPS의 수신 설정
 i_stState : ST_UpsState; // 장비 상태
 i_stRaw : ST_UpsRaw; // 되읽기용 원본
 i_ipUps : I_Ups; // 쓰기 대상
 i_tTimeout : TIME := T#10S; // 주소 하나의 쓰기·되읽기 제한 시간
 i_bUpsFault : BOOL; // UPS 고장 있음 (보고 Status b6). 켜져 있으면 쓰지 않음
 i_tRecheck : TIME := T#10S; // 보관값과 UPS 값을 비교하는 주기
 i_nMaxFail : UINT := 3; // 연속 실패 허용 횟수. 넘으면 q_bMismatch
END_VAR
VAR_IN_OUT
 iq_stDesired : ST_UpsDesiredSet; // 맞춰 둘 설정 보관값 (GVL_PERSIST.g_astUpsDesired[n])
END_VAR
VAR_OUTPUT
 q_bBusy : BOOL; // 적용 중
 q_eResult : E_UpsResult; // 마지막 적용 결과
 q_nErrorAddress : UINT; // 실패한 H 주소. 0 = 없음
 q_nAppliedRx : UDINT; // 마지막으로 처리한 수신 누계
 q_nWriteCount : UDINT; // 적용한 주소 수 누계
 q_bDesiredChanged : BOOL; // 이 스캔에 보관값을 바꿈 (PERSISTENT 바로 저장 요청)
 q_bMismatch : BOOL; // 설정 불일치 알람: 연속 i_nMaxFail회 실패. 새 설정을 받으면 풀림
 q_nRecoverCount : UDINT; // 복구로 다시 쓴 주소 수 누계
END_VAR
VAR CONSTANT
 ITEM_COUNT : UINT := 7;
 ADDRESS_FIRST : UINT := 50; // H50~H56
END_VAR
VAR
 _nStep : UINT;
 _nItem : UINT;
 _nLastRx : UDINT;
 _bBad : BOOL;
 _awTarget : ARRAY[0..ITEM_COUNT-1] OF WORD; // 쓸 값
 _abUse : ARRAY[0..ITEM_COUNT-1] OF BOOL;
 _tonTimeout : TON;
 _tonRecheck : TON; // 비교 주기
 _bRecover : BOOL; // 지금 진행 중인 쓰기가 복구인지 (수신이 아니라)
 _nFail : UINT; // 연속 실패 횟수
 _nCheck : UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[_tonTimeout(IN:=_nStep=20 OR _nStep=30, PT:=i_tTimeout);
_tonRecheck(IN:=_nStep=0 AND NOT _tonRecheck.Q, PT:=i_tRecheck);
q_bDesiredChanged:=FALSE;

CASE _nStep OF
 0: // 새 설정 대기
  q_bBusy:=FALSE;
  IF i_nRxCount<>_nLastRx THEN
   _nLastRx:=i_nRxCount;
   q_nErrorAddress:=0;
   IF NOT i_bEnable OR i_ipUps=0 THEN
    q_eResult:=E_UpsResult.Disabled;
    q_nAppliedRx:=_nLastRx;
   ELSE
    M_Load();
    IF _bBad THEN
     q_eResult:=E_UpsResult.BadConfig;
     q_nAppliedRx:=_nLastRx;
    ELSE
     // 받은 설정을 보관값으로 남김 (CF-UPS-02)
     iq_stDesired.abUse:=_abUse;
     iq_stDesired.awValue:=_awTarget;
     iq_stDesired.nRxCount:=_nLastRx;
     iq_stDesired.bValid:=TRUE;
     q_bDesiredChanged:=TRUE;
     q_bMismatch:=FALSE;
     _nFail:=0;
     _bRecover:=FALSE;
     q_bBusy:=TRUE;
     q_eResult:=E_UpsResult.Busy;
     _nItem:=0;
     _nStep:=10;
    END_IF
   END_IF
  ELSIF _tonRecheck.Q AND iq_stDesired.bValid AND i_bEnable AND i_ipUps<>0 AND NOT q_bMismatch AND i_stState.bValid THEN
   // 복구 (CF-UPS-03): 보관값과 UPS 값이 다른 칸이 있으면 다시 쓴다
   _abUse:=iq_stDesired.abUse;
   _awTarget:=iq_stDesired.awValue;
   _bRecover:=FALSE;
   FOR _nCheck:=0 TO ITEM_COUNT-1 DO
    IF _abUse[_nCheck] AND i_stRaw.awParam[ADDRESS_FIRST+_nCheck]<>_awTarget[_nCheck] THEN
     _bRecover:=TRUE;
    END_IF
   END_FOR
   IF _bRecover THEN
    q_nErrorAddress:=0;
    q_bBusy:=TRUE;
    q_eResult:=E_UpsResult.Busy;
    _nItem:=0;
    _nStep:=10;
   END_IF
  END_IF

 10: // 부동충전 상태에서만 진행
  IF NOT i_bEnable THEN
   q_eResult:=E_UpsResult.Disabled;
   q_nAppliedRx:=_nLastRx;
   _nStep:=0;
  ELSIF i_stState.bValid AND i_stState.nBatMode=0 AND NOT i_bUpsFault AND NOT i_stState.bEmergencyStop THEN
   WHILE _nItem<ITEM_COUNT DO
    IF _abUse[_nItem] AND i_stRaw.awParam[ADDRESS_FIRST+_nItem]<>_awTarget[_nItem] THEN EXIT; END_IF
    _nItem:=_nItem+1;
   END_WHILE
   IF _nItem>=ITEM_COUNT THEN
    q_eResult:=E_UpsResult.Accepted;
    q_nAppliedRx:=_nLastRx;
    _nFail:=0;
    _bRecover:=FALSE;
    _nStep:=0;
   ELSE
    _nStep:=20;
   END_IF
  END_IF

 20: // 쓰기 요청
  IF i_ipUps.M_SetParameter(UINT_TO_WORD(ADDRESS_FIRST+_nItem),_awTarget[_nItem]) THEN
   _nStep:=30;
  ELSIF _tonTimeout.Q THEN
   _nStep:=900;
  END_IF

 30: // 되읽기 확인
  IF i_stRaw.awParam[ADDRESS_FIRST+_nItem]=_awTarget[_nItem] THEN
   q_nWriteCount:=q_nWriteCount+1;
   IF _bRecover THEN q_nRecoverCount:=q_nRecoverCount+1; END_IF
   _nItem:=_nItem+1;
   _nStep:=10;
  ELSIF _tonTimeout.Q THEN
   _nStep:=900;
  END_IF

 900: // 실패. 남은 주소는 쓰지 않음
  q_eResult:=E_UpsResult.CommUnavailable;
  q_nErrorAddress:=ADDRESS_FIRST+_nItem;
  q_nAppliedRx:=_nLastRx;
  _nFail:=_nFail+1;
  IF _nFail>=i_nMaxFail THEN q_bMismatch:=TRUE; END_IF // 반복을 멈추고 알람
  _bRecover:=FALSE;
  _nStep:=0;
END_CASE]]></ST>
    </Implementation>
    <Method Name="M_Load" Id="{00b4605e-ed77-4b5f-9061-112fb14dbe73}">
      <Declaration><![CDATA[METHOD PRIVATE M_Load
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_bBad:=FALSE;
_abUse[0]:=i_stConfig.PeriodicTrickleDischargeSetCurrent.is_available<>0;
IF _abUse[0] THEN
 IF i_stConfig.PeriodicTrickleDischargeSetCurrent.value>0.0 AND i_stConfig.PeriodicTrickleDischargeSetCurrent.value<=GVL_PARAM.UPS_CFG_MAX_CURRENT_A THEN
  _awTarget[0]:=REAL_TO_WORD(i_stConfig.PeriodicTrickleDischargeSetCurrent.value*10.0);
 ELSE _bBad:=TRUE; q_nErrorAddress:=50; END_IF
END_IF
_abUse[1]:=i_stConfig.PeriodicTrickleDischargeSetTime.is_available<>0;
IF _abUse[1] THEN
 IF i_stConfig.PeriodicTrickleDischargeSetTime.value>0 AND i_stConfig.PeriodicTrickleDischargeSetTime.value<=GVL_PARAM.UPS_CFG_MAX_MINUTES THEN
  _awTarget[1]:=UDINT_TO_WORD(i_stConfig.PeriodicTrickleDischargeSetTime.value);
 ELSE _bBad:=TRUE; q_nErrorAddress:=51; END_IF
END_IF
_abUse[2]:=i_stConfig.PulseDischargeSetCurrent.is_available<>0;
IF _abUse[2] THEN
 IF i_stConfig.PulseDischargeSetCurrent.value>0.0 AND i_stConfig.PulseDischargeSetCurrent.value<=GVL_PARAM.UPS_CFG_MAX_CURRENT_A THEN
  _awTarget[2]:=REAL_TO_WORD(i_stConfig.PulseDischargeSetCurrent.value*10.0);
 ELSE _bBad:=TRUE; q_nErrorAddress:=52; END_IF
END_IF
_abUse[3]:=i_stConfig.PulseChargeSetCurrent.is_available<>0;
IF _abUse[3] THEN
 IF i_stConfig.PulseChargeSetCurrent.value>0.0 AND i_stConfig.PulseChargeSetCurrent.value<=GVL_PARAM.UPS_CFG_MAX_CURRENT_A THEN
  _awTarget[3]:=REAL_TO_WORD(i_stConfig.PulseChargeSetCurrent.value*10.0);
 ELSE _bBad:=TRUE; q_nErrorAddress:=53; END_IF
END_IF
_abUse[4]:=i_stConfig.PulseDischargeSetTime.is_available<>0;
IF _abUse[4] THEN
 IF i_stConfig.PulseDischargeSetTime.value>0 AND i_stConfig.PulseDischargeSetTime.value<=GVL_PARAM.UPS_CFG_MAX_SECONDS THEN
  _awTarget[4]:=UDINT_TO_WORD(i_stConfig.PulseDischargeSetTime.value);
 ELSE _bBad:=TRUE; q_nErrorAddress:=54; END_IF
END_IF
_abUse[5]:=i_stConfig.PulseChargeSetTime.is_available<>0;
IF _abUse[5] THEN
 IF i_stConfig.PulseChargeSetTime.value>0 AND i_stConfig.PulseChargeSetTime.value<=GVL_PARAM.UPS_CFG_MAX_SECONDS THEN
  _awTarget[5]:=UDINT_TO_WORD(i_stConfig.PulseChargeSetTime.value);
 ELSE _bBad:=TRUE; q_nErrorAddress:=55; END_IF
END_IF
_abUse[6]:=i_stConfig.PulseChargeDischargeSetCycle.is_available<>0;
IF _abUse[6] THEN
 IF i_stConfig.PulseChargeDischargeSetCycle.value>0 AND i_stConfig.PulseChargeDischargeSetCycle.value<=GVL_PARAM.UPS_CFG_MAX_CYCLES THEN
  _awTarget[6]:=UDINT_TO_WORD(i_stConfig.PulseChargeDischargeSetCycle.value);
 ELSE _bBad:=TRUE; q_nErrorAddress:=56; END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
