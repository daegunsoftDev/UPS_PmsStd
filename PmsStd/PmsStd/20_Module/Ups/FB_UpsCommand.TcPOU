<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_UpsCommand" Id="{fdd1a924-ca04-4056-888d-a436d42b41d3}" SpecialFunc="None">
    <Declaration><![CDATA[(* EMS UPS 명령 → 세방 UPS 명령 레지스터(0x55) 요청, 온도보상 켜짐 상태 복구 (⑤출력 / 장치: UPS). 2026-11-05.
   기반 없음(신규).
   변경: 없음
   부호·단위: 해당 없음. 명세: C:\gil\UPS\명세서\UPS_명세서.md WR-UPS-01, WR-SQ-01, CF-UPS-03(켜짐 상태)
   - CommandType은 비트이고 b1부터 쓴다 (b0 비움): b1 간헐충전 시작(H118), b2 주기적 방전 시작(H115), b3 펄스 방전 시작(H116),
     b4 온도보상충전 시작(H120), b5 부동충전(H110), b6 방전 정지(H117), b7 간헐충전 정지(H119),
     b8 온도보상충전 정지(H121), b9 알람 리셋(H100), b10 Fault 단계 확인(장비에 쓰지 않음, q_bAck)
   - 여러 비트가 함께 오면 정지·리셋(b6~b9)을 먼저, 시작(b1~b5)을 나중에 한 스캔에 하나씩 보낸다.
     같은 기능의 시작과 정지가 함께 오면 둘 다 거부한다 (b1+b7, b4+b8, b2·b3+b6)
   - 거부: UPS 통신이상이면 b1~b9 모두. UPS 고장(Status b6)이나 e-stop(b7) 중이면 시작 b1~b5
   - 쓰기 허용(i_bEnable)이 꺼져 있으면 b1~b9는 실행하지 않고 Disabled
   - 온도보상: 켜 둬야 하는데(iq_stDesired.bTempCompOn) UPS가 꺼져 있으면 i_tRecheck마다 시작 명령을 다시 보낸다.
     i_nMaxFail회 연속으로 켜지지 않으면 q_bEnableMismatch를 켜고 멈춘다. b4·b8을 받으면 풀린다 *)
FUNCTION_BLOCK FB_UpsCommand
VAR_INPUT
	i_stCmd			: ST_IfUpsCmd;			// 받은 명령 (번호가 바뀌면 새 명령)
	i_bEnable		: BOOL;					// 장비 쓰기 허용
	i_stUps			: ST_UpsPublish_V1;		// UPS 보고값 (Status b6 고장, b7 e-stop, b17 온도보상)
	i_bUpsValid		: BOOL;					// UPS 통신 정상
	i_ipUps			: I_Ups;				// 명령 대상
	i_tRequestTimeout : TIME := T#5S;		// 드라이버가 요청을 받지 못하면 실패로 보는 시간
	i_tRecheck		: TIME := T#10S;		// 온도보상 켜짐 상태 확인 주기
	i_nMaxFail		: UINT := 3;			// 켜짐 상태 복구 연속 실패 허용 횟수
END_VAR
VAR_IN_OUT
	iq_stDesired	: ST_UpsDesiredSet;		// 켜짐 상태 보관값 (GVL_PERSIST.g_astUpsDesired[n])
END_VAR
VAR_OUTPUT
	q_bAck				: BOOL;				// Fault 단계 확인 (b10을 받은 스캔에 TRUE)
	q_nLastType			: UDINT;			// 마지막으로 받은 명령 비트
	q_eLastResult		: E_UpsResult;		// 마지막 명령 결과
	q_nRejectCount		: UDINT;			// 상태 때문에 거부한 명령 수
	q_nUnknownCount		: UDINT;			// 모르는 비트(b0, b11 이상)나 0을 받은 수
	q_bDesiredChanged	: BOOL;				// 이 스캔에 켜짐 상태 보관값을 바꿈 (바로 저장 요청)
	q_bEnableMismatch	: BOOL;				// 온도보상 복구 연속 실패 알람
	q_nRestoreCount		: UDINT;			// 온도보상 복구로 시작 명령을 보낸 횟수
END_VAR
VAR
	_nLastSeq		: UDINT;
	_bInit			: BOOL;
	_dwPending		: DWORD;				// 드라이버에 넘길 명령 비트 (b1~b9)
	_tonRequest		: TON;
	_tonRecheck		: TON;
	_nFail			: UINT;
	_bRestoreSent	: BOOL;					// 지난 확인 때 복구 명령을 보냄
	_bFault			: BOOL;
	_bEStop			: BOOL;
	_eCmd			: E_UpsCommand;
	_dwNew			: DWORD;
	_nBit			: INT;
	_nOrder			: INT;
	_bAccepted		: BOOL;
END_VAR
VAR CONSTANT
	START_BITS		: DWORD := 16#003E;	// b1~b5 시작 명령
	DEVICE_BITS		: DWORD := 16#03FE;	// b1~b9 장비에 쓰는 명령
	ACK_BIT			: DWORD := 16#0400;	// b10 Fault 단계 확인
	SEND_ORDER		: ARRAY[0..8] OF INT := [6, 7, 8, 9, 1, 2, 3, 4, 5];	// 정지·리셋 먼저, 시작 나중
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[q_bAck := FALSE;
q_bDesiredChanged := FALSE;
_bFault := i_stUps.Status.6;
_bEStop := i_stUps.Status.7;

// 처음 스캔: 재시작 전에 받은 명령 번호를 다시 실행하지 않음
IF NOT _bInit THEN
	_bInit := TRUE;
	_nLastSeq := i_stCmd.nSeq;
END_IF

// 1) 새 명령 (CommandType 비트)
IF i_stCmd.nSeq <> _nLastSeq THEN
	_nLastSeq := i_stCmd.nSeq;
	q_nLastType := i_stCmd.nType;
	_dwNew := UDINT_TO_DWORD(i_stCmd.nType);
	IF _dwNew = 0 OR (_dwNew AND NOT (DEVICE_BITS OR ACK_BIT)) <> 0 THEN
		q_nUnknownCount := q_nUnknownCount + 1;	// 0이거나 정의되지 않은 비트. 정의된 비트는 계속 처리
		q_eLastResult := E_UpsResult.BadRequest;
	END_IF
	IF (_dwNew AND ACK_BIT) <> 0 THEN
		q_bAck := TRUE;	// Fault 단계 확인: PMS 안에서만 처리
		q_eLastResult := E_UpsResult.Accepted;
	END_IF
	_dwNew := _dwNew AND DEVICE_BITS;
	// 같은 기능의 시작과 정지가 함께 오면 둘 다 버림
	IF _dwNew.1 AND _dwNew.7 THEN _dwNew.1 := FALSE; _dwNew.7 := FALSE; q_nRejectCount := q_nRejectCount + 1; END_IF
	IF _dwNew.4 AND _dwNew.8 THEN _dwNew.4 := FALSE; _dwNew.8 := FALSE; q_nRejectCount := q_nRejectCount + 1; END_IF
	IF (_dwNew.2 OR _dwNew.3) AND _dwNew.6 THEN _dwNew.2 := FALSE; _dwNew.3 := FALSE; _dwNew.6 := FALSE; q_nRejectCount := q_nRejectCount + 1; END_IF
	IF _dwNew <> 0 THEN
		IF NOT i_bUpsValid THEN
			_dwNew := 0;
			q_nRejectCount := q_nRejectCount + 1;
			q_eLastResult := E_UpsResult.CommUnavailable;
		ELSE
			IF (_bFault OR _bEStop) AND (_dwNew AND START_BITS) <> 0 THEN
				_dwNew := _dwNew AND NOT START_BITS;	// 고장·e-stop 중 시작 명령 거부, 정지·리셋은 남김
				q_nRejectCount := q_nRejectCount + 1;
				q_eLastResult := E_UpsResult.BadRequest;
			END_IF
			IF _dwNew <> 0 THEN
				IF NOT i_bEnable OR i_ipUps = 0 THEN
					q_eLastResult := E_UpsResult.Disabled;
				ELSE
					_dwPending := _dwNew;	// 앞의 요청이 남아 있으면 새 명령으로 바꿈 (마지막 명령이 우선)
					q_eLastResult := E_UpsResult.Busy;
				END_IF
			END_IF
		END_IF
	END_IF
END_IF

// 2) 드라이버에 한 스캔에 하나씩 요청. 받아들이면 켜짐 상태 보관값 갱신
_bAccepted := FALSE;
_tonRequest(IN := _dwPending <> 0, PT := i_tRequestTimeout);
IF _dwPending <> 0 THEN
	_nBit := -1;
	FOR _nOrder := 0 TO 8 DO
		IF _nBit < 0 AND (_dwPending AND SHL(DWORD#1, SEND_ORDER[_nOrder])) <> 0 THEN
			_nBit := SEND_ORDER[_nOrder];
		END_IF
	END_FOR
	CASE _nBit OF
		1:	_eCmd := E_UpsCommand.TrickleOn;
		2:	_eCmd := E_UpsCommand.PeriodicDischarge;
		3:	_eCmd := E_UpsCommand.PulseDischarge;
		4:	_eCmd := E_UpsCommand.TemperatureOn;
		5:	_eCmd := E_UpsCommand.FloatCharge;
		6:	_eCmd := E_UpsCommand.CancelDischarge;
		7:	_eCmd := E_UpsCommand.TrickleOff;
		8:	_eCmd := E_UpsCommand.TemperatureOff;
		9:	_eCmd := E_UpsCommand.Reset;
	END_CASE
	IF i_ipUps.M_RequestCommand(_eCmd) THEN
		_bAccepted := TRUE;
		_dwPending := _dwPending AND NOT SHL(DWORD#1, _nBit);
		q_eLastResult := E_UpsResult.Accepted;
		CASE _nBit OF
			1:	iq_stDesired.bTrickleOn := TRUE;	q_bDesiredChanged := TRUE;
			7:	iq_stDesired.bTrickleOn := FALSE;	q_bDesiredChanged := TRUE;
			4:	iq_stDesired.bTempCompOn := TRUE;	q_bDesiredChanged := TRUE;	q_bEnableMismatch := FALSE;	_nFail := 0;	_bRestoreSent := FALSE;
			8:	iq_stDesired.bTempCompOn := FALSE;	q_bDesiredChanged := TRUE;	q_bEnableMismatch := FALSE;	_nFail := 0;	_bRestoreSent := FALSE;
		END_CASE
		_tonRequest(IN := FALSE);	// 다음 비트는 시간을 새로 잼
	ELSIF _tonRequest.Q THEN
		_dwPending := 0;	// 드라이버가 받지 못함. 남은 비트도 버림
		q_eLastResult := E_UpsResult.CommUnavailable;
	END_IF
END_IF

// 3) 온도보상 켜짐 상태 복구 (CF-UPS-03)
_tonRecheck(IN := NOT _tonRecheck.Q, PT := i_tRecheck);
IF _tonRecheck.Q AND _dwPending = 0 AND NOT _bAccepted THEN
	IF i_stUps.Status.17 OR NOT iq_stDesired.bTempCompOn THEN
		_nFail := 0;					// 켜져 있거나 켤 필요 없음
		_bRestoreSent := FALSE;
	ELSIF i_bUpsValid AND i_bEnable AND i_ipUps <> 0 AND NOT _bFault AND NOT _bEStop AND NOT q_bEnableMismatch THEN
		IF _bRestoreSent THEN
			_nFail := _nFail + 1;		// 지난번에 보냈는데 아직 꺼져 있음
		END_IF
		IF _nFail >= i_nMaxFail THEN
			q_bEnableMismatch := TRUE;	// 반복을 멈추고 알람
		ELSIF i_ipUps.M_RequestCommand(E_UpsCommand.TemperatureOn) THEN
			_bRestoreSent := TRUE;
			q_nRestoreCount := q_nRestoreCount + 1;
		END_IF
	END_IF
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>