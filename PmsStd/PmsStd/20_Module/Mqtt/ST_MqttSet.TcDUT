	nSiteId			: UDINT;			// 사이트 번호 (토픽·헤더·ClientId에 들어감)
	stCloud			: ST_MqttBroker;
	stLocal			: ST_MqttBroker;
	stAzure			: ST_MqttBroker;
	sUserName		: STRING;			// 브로커 계정 (세 브로커 공통)
	sUserPassword	: STRING;
END_STRUCT
END_TYPE]]></Declaration>
