<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <DUT Name="ST_MqttCommand_Rx" Id="{151a57c0-4a25-41d6-bd3b-a15635e8751f}">
    <Declaration><![CDATA[{attribute 'pack_mode' := '1'}
TYPE ST_MqttCommand_Rx :
STRUCT	// 인터페이스 100.Command (2026-11-12): 20 B
	SequenceNumber	:	UDINT;	// 명령 번호. 같은 번호가 다시 오면 버림 (중복 방지, 0이면 거르지 않음). FB_EmsCmdGate
	DeviceIndex	:	UDINT;	// 장치 번호 1부터 (F_MqttDistribute가 레코드 앞 4 B 뒤에서 읽음: nIndexOffset = 4)
	CommandType	:	UDINT;
	Value		:	REAL;	// kW 등, CommandType에 따라 의미가 다름
	Delay		:	UDINT;	// ms. 이만큼 기다렸다가 실행 (0이면 바로). FB_EmsCmdGate
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>