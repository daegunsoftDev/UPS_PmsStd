<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <DUT Name="ST_MqttCommandHeader" Id="{a6766023-3fe4-47fb-ae60-3ae2efad023d}">
    <Declaration><![CDATA[{attribute 'pack_mode' := '1'}
TYPE ST_MqttCommandHeader :
STRUCT
	HeaderVersion	:	UDINT;
	CommandVersion	:	UDINT;
	DeviceCount		:	UDINT;		// 이 메시지에 실린 장치 레코드 개수
	Location		:	UDINT;		// 0: PMS, 1: LOCAL, 2: CLOUD
	SiteID			:	UDINT;
	UserName		:	STRING(19);		//EMS에서 준 것 그대로 전송
	TimeStamp		:	STRING(23);
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>