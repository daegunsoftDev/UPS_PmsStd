<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <DUT Name="ST_MqttSubEntry" Id="{1a7b2efb-d304-4398-aace-775ec8edd01b}">
    <Declaration><![CDATA[TYPE ST_MqttSubEntry :
STRUCT
	sCategory		:	STRING(10);	// 토픽 2번째 세그먼트. 'command' 또는 'config'
	sTopic			:	STRING(20);	// device_name (예: 'pcs', 'bat', 'protection')
	bIndexed		:	BOOL;			// TRUE: 레코드 선두 DeviceIndex/DeviceId(UDINT)로 배열에 분배
									// FALSE: 헤더 뒤 레코드 1개를 목적지에 그대로 복사(고정 1건, protection 등)
	pDestArray		:	PVOID;			// 목적지 배열(또는 단일 구조체) 시작 주소
	nElementSize	:	UDINT;			// 레코드 1개 크기 (= 목적지 구조체 SIZEOF)
	nDeviceCapacity  : UDINT;//nMaxIndex		:	INT;			// bIndexed=TRUE일 때만 사용. 목적지 배열의 최대 인덱스(0-based)
	nSeqNum			:	UINT;			// 토픽별 수신 카운터. 100 초과 시 0으로 초기화

	pRxBuffer		:	PVOID;		// 이 토픽 전용 수신 버퍼 주소
	nRxBufferSize	:	UDINT;		// 그 버퍼의 실제 크기
	
	nMaxRecords      : UDINT;   // (nRxBufferSize - SIZEOF(Header)) / nElementSize, 빌드 시 1회 계산
	
	nDeviceIdBase	: UDINT;		// DEVICE_ID_BASE(1)에 더하는 토픽별 추가 시작 번호. 지금은 모두 0 [1부터 2026-11-10]
	nIndexOffset	: UDINT;		// 레코드 시작에서 DeviceIndex/DeviceId까지 바이트. command 토픽 4 (앞에 SequenceNumber), config 0 [2026-11-12]
END_STRUCT
END_TYPE
//dgsems/{solution}/{site_id}/{category}/{device_name}]]></Declaration>
  </DUT>
</TcPlcObject>