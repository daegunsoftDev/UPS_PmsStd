<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_MqttMain" Id="{96768971-4aff-474f-8cb8-65b824bc9be0}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MqttMain		// MQTT 보고·명령 로직: 시각 문자열, 발행·구독 토픽 표, 브로커 3개(Cloud·Local·Azure) 발행·구독, 로거 이벤트 발행 (PRG_Mqtt가 부름. 접속 설정은 i_stSet = GVL_SITE.MQTT_SET)
VAR_INPUT
	i_stSet				: ST_MqttSet;		// 접속 설정 (사이트 번호·브로커·계정)
	i_sInstance			: STRING(4) := '';	// ClientId 뒤에 붙임. 이중화: Primary '-P', Secondary '-S' (두 PLC가 같은 ClientId면 브로커가 서로 끊음)
	i_bPublish			: BOOL := TRUE;		// 발행 허가 (이중화: Active만 발행. 구독은 두 PLC 모두)
	i_bReady			: BOOL := TRUE;		// 접속 시작 허가 (이중화: 역할이 정해진 뒤)
END_VAR
VAR_OUTPUT
	q_abBrokerUse		: ARRAY[1..3] OF BOOL;	// 쓰는 브로커 (1 Cloud, 2 Local, 3 Azure = i_stSet bUse) [9번 수정 2026-11-09: 추가]
	q_abBrokerConn		: ARRAY[1..3] OF BOOL;	// 구독 클라이언트가 접속됨 (쓰지 않는 브로커·접속 시작 전은 FALSE)
END_VAR
VAR
	(* ---------- 토픽 표 ---------- *)
	bTableInit			: BOOL;
	astPubDeviceTable	: ARRAY[1..GVL_MQTT.DEVICE_TOPIC_COUNT] OF ST_MqttPubEntry;
	astPubConfigTable	: ARRAY[1..GVL_MQTT.CONFIG_TOPIC_COUNT] OF ST_MqttPubEntry;
	astSubCommandTable	: ARRAY[1..GVL_MQTT.COMMAND_TOPIC_COUNT] OF ST_MqttSubEntry;
	astSubConfigTable	: ARRAY[1..GVL_MQTT.CONFIG_TOPIC_COUNT] OF ST_MqttSubEntry;

	(* 토픽별 수신 버퍼: 헤더 + 그 토픽의 최대 레코드 수 (config pcs·bat은 GVL_MQTT 수신 패킷을 버퍼로 씀) *)
	anRxPcsCommand		: ARRAY[0..(SIZEOF(ST_MqttCommandHeader) + SIZEOF(ST_MqttCommand_Rx) * GVL_PARAM.PCS_COUNT - 1)] OF BYTE;
	anRxBatCommand		: ARRAY[0..(SIZEOF(ST_MqttCommandHeader) + SIZEOF(ST_MqttCommand_Rx) * GVL_PARAM.BMS_COUNT - 1)] OF BYTE;
	anRxUpsCommand		: ARRAY[0..(SIZEOF(ST_MqttCommandHeader) + SIZEOF(ST_MqttCommand_Rx) * GVL_PARAM.UPS_COUNT - 1)] OF BYTE;
	anRxProtectionConfig : ARRAY[0..(SIZEOF(ST_MqttCommandHeader) + SIZEOF(ST_ProtectionConfig_Rx) - 1)] OF BYTE;

	(* ---------- 브로커 ---------- *)
	fbCloudSub			: FB_MqttSubscribe;
	fbCloudPub			: FB_MqttPublish;
	fbLocalSub			: FB_MqttSubscribe;
	fbLocalPub			: FB_MqttPublish;
	fbAzureSub			: FB_MqttSubscribe;
	fbAzurePub			: FB_MqttPublish;
	tonStartDelay		: TON := (PT := T#10S);		// 기동 뒤 통신 시작 지연

	(* ---------- 시각 ---------- *)
	fbLocalTime			: FB_LocalSystemTime := (sNetID := '', bEnable := TRUE);
	sTimeStamp			: STRING(23);		// '2024-09-04 11:11:11.123' (보고 헤더·DB 저장 시각)

	(* ---------- 수신 합산 (브로커 3개 → GVL_MQTT) ---------- *)
	i					: UINT;
	anPrevCmdCount		: ARRAY[1..3, 1..GVL_MQTT.COMMAND_TOPIC_COUNT] OF UDINT;	// 1 Cloud, 2 Local, 3 Azure
	anPrevCfgCount		: ARRAY[1..3, 1..GVL_MQTT.CONFIG_TOPIC_COUNT] OF UDINT;

	(* ---------- 로거 (이벤트 로그 → pms_log 토픽, 20_Module/Mqtt/Logger) ---------- *)
	fbLogger			: FB_MqttLoggerListener;
	anLoggerNext		: ARRAY[1..3] OF UDINT := [1, 1, 1];	// 브로커별 다음에 보낼 이벤트 번호 (1 Cloud, 2 Local, 3 Azure)
	stLoggerPacket		: ST_LoggerPublish_V1;
	nUtcOffset			: LINT;		// 현지 시각 − UTC (100 ns). 로거 시각(UTC)을 현지 시각으로 바꿀 때 씀
	bUtcOffsetValid		: BOOL;
	stLocalFileTime		: T_FILETIME;
	nLocalFileTime		: ULINT;
	nOffsetRaw			: LINT;
END_VAR
VAR CONSTANT
	OFFSET_STEP			: LINT := 9000000000;	// 시간대 단위 15분 (100 ns). 두 시각을 읽는 사이의 차이를 반올림으로 없앰
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* 1. 시각 문자열 *)
fbLocalTime();
A_MakeTimeStamp();

(* 2. 토픽 표 (처음 한 번) *)
IF NOT bTableInit THEN
	A_InitPublishTable();
	A_InitSubscribeTable();
	bTableInit := TRUE;
END_IF
A_MapPublishHeader();

(* 2-1. 로거 이벤트 받기: 접속 지연과 상관없이 처음부터 (기동 직후 로그도 큐에 쌓였다가 접속하면 나감) *)
fbLogger.M_Cycle(i_nUtcOffset := nUtcOffset, i_bTimeValid := bUtcOffsetValid);

(* 3. 브로커 발행·구독 *)
tonStartDelay(IN := TRUE);
IF tonStartDelay.Q AND i_bReady THEN
	IF i_stSet.stCloud.bUse THEN
		fbCloudPub(i_sConnLabel := 'Cloud', i_nSiteId := i_stSet.nSiteId, i_sHost := i_stSet.stCloud.sHost, i_nPort := i_stSet.stCloud.nPort, i_sUserName := i_stSet.sUserName, i_sUserPassword := i_stSet.sUserPassword, i_astDeviceTable := astPubDeviceTable, i_sInstance := i_sInstance, i_bPublish := i_bPublish, i_astConfigTable := astPubConfigTable);
		fbCloudSub(i_nSiteId := i_stSet.nSiteId, i_sHost := i_stSet.stCloud.sHost, i_nPort := i_stSet.stCloud.nPort, i_sUserName := i_stSet.sUserName, i_sUserPassword := i_stSet.sUserPassword, i_astCommandTable := astSubCommandTable, i_sInstance := i_sInstance, i_astConfigTable := astSubConfigTable);
	END_IF
	IF i_stSet.stLocal.bUse THEN
		fbLocalPub(i_sConnLabel := 'local', i_nSiteId := i_stSet.nSiteId, i_sHost := i_stSet.stLocal.sHost, i_nPort := i_stSet.stLocal.nPort, i_sUserName := i_stSet.sUserName, i_sUserPassword := i_stSet.sUserPassword, i_astDeviceTable := astPubDeviceTable, i_sInstance := i_sInstance, i_bPublish := i_bPublish, i_astConfigTable := astPubConfigTable);
		fbLocalSub(i_nSiteId := i_stSet.nSiteId, i_sHost := i_stSet.stLocal.sHost, i_nPort := i_stSet.stLocal.nPort, i_sUserName := i_stSet.sUserName, i_sUserPassword := i_stSet.sUserPassword, i_astCommandTable := astSubCommandTable, i_sInstance := i_sInstance, i_astConfigTable := astSubConfigTable);
	END_IF
	IF i_stSet.stAzure.bUse THEN
		fbAzurePub(i_sConnLabel := 'Azure', i_nSiteId := i_stSet.nSiteId, i_sHost := i_stSet.stAzure.sHost, i_nPort := i_stSet.stAzure.nPort, i_sUserName := i_stSet.sUserName, i_sUserPassword := i_stSet.sUserPassword, i_astDeviceTable := astPubDeviceTable, i_sInstance := i_sInstance, i_bPublish := i_bPublish, i_astConfigTable := astPubConfigTable);
		fbAzureSub(i_nSiteId := i_stSet.nSiteId, i_sHost := i_stSet.stAzure.sHost, i_nPort := i_stSet.stAzure.nPort, i_sUserName := i_stSet.sUserName, i_sUserPassword := i_stSet.sUserPassword, i_astCommandTable := astSubCommandTable, i_sInstance := i_sInstance, i_astConfigTable := astSubConfigTable);
	END_IF

	A_MergeRxCount();
	A_PublishLogger();
END_IF
// [9번 수정 2026-11-09: 추가] 브로커 접속 상태 (PRG_Mqtt → GVL_IF → MAIN FB_BrokerWatch)
q_abBrokerUse[1]	:= i_stSet.stCloud.bUse;
q_abBrokerUse[2]	:= i_stSet.stLocal.bUse;
q_abBrokerUse[3]	:= i_stSet.stAzure.bUse;
q_abBrokerConn[1]	:= i_stSet.stCloud.bUse AND tonStartDelay.Q AND i_bReady AND fbCloudSub.q_bConnected;
q_abBrokerConn[2]	:= i_stSet.stLocal.bUse AND tonStartDelay.Q AND i_bReady AND fbLocalSub.q_bConnected;
q_abBrokerConn[3]	:= i_stSet.stAzure.bUse AND tonStartDelay.Q AND i_bReady AND fbAzureSub.q_bConnected;]]></ST>
    </Implementation>
    <Action Name="A_InitPublishTable" Id="{20178adb-5240-452e-ba16-a70b939ea5de}">
      <Implementation>
        <ST><![CDATA[astPubDeviceTable[1].sTopic          := 'pms';
astPubDeviceTable[1].pDeviceSrc       := ADR(g_stPmsPublish.Devices);
astPubDeviceTable[1].nDeviceElemSize  := SIZEOF(ST_PmsPublish_V1);
astPubDeviceTable[1].nDeviceCount     := 1;
astPubDeviceTable[1].pStaging         := ADR(g_stPmsPublish);
astPubDeviceTable[1].nStagingSize     := SIZEOF(g_stPmsPublish);
astPubDeviceTable[1].sCategory       := '';

astPubDeviceTable[2].sTopic          := 'pcs';
astPubDeviceTable[2].pDeviceSrc       := ADR(g_stPcsPublish.Devices);
astPubDeviceTable[2].nDeviceElemSize  := SIZEOF(ST_PcsPublish_V1);
astPubDeviceTable[2].nDeviceCount     := UINT_TO_UDINT(GVL_PARAM.INSTALLED_PCS_COUNT);
astPubDeviceTable[2].pStaging         := ADR(g_stPcsPublish);
astPubDeviceTable[2].nStagingSize     := SIZEOF(g_stPcsPublish);
astPubDeviceTable[2].sCategory       := '';

astPubDeviceTable[3].sTopic          := 'bat';
astPubDeviceTable[3].pDeviceSrc       := ADR(g_stBatPublish.Devices);
astPubDeviceTable[3].nDeviceElemSize  := SIZEOF(ST_BatPublish_V1);
astPubDeviceTable[3].nDeviceCount     := UINT_TO_UDINT(GVL_PARAM.BMS_COUNT);
astPubDeviceTable[3].pStaging         := ADR(g_stBatPublish);
astPubDeviceTable[3].nStagingSize     := SIZEOF(g_stBatPublish);
astPubDeviceTable[3].sCategory       := '';


astPubDeviceTable[4].sTopic          := 'rack';
astPubDeviceTable[4].pDeviceSrc       := ADR(g_stRackPublish.Devices);
astPubDeviceTable[4].nDeviceElemSize  := SIZEOF(ST_RackPublish_V1);
astPubDeviceTable[4].nDeviceCount     := UINT_TO_UDINT(GVL_PARAM.RACK_COUNT);
astPubDeviceTable[4].pStaging         := ADR(g_stRackPublish);
astPubDeviceTable[4].nStagingSize     := SIZEOF(g_stRackPublish);
astPubDeviceTable[4].sCategory       := '';

astPubDeviceTable[5].sTopic          := 'pv_meter';
astPubDeviceTable[5].pDeviceSrc       := ADR(g_stPvPublish.Devices);
astPubDeviceTable[5].nDeviceElemSize  := SIZEOF(ST_PvPublish_V1);
astPubDeviceTable[5].nDeviceCount     := UINT_TO_UDINT(GVL_PARAM.PV_COUNT);
astPubDeviceTable[5].pStaging         := ADR(g_stPvPublish);
astPubDeviceTable[5].nStagingSize     := SIZEOF(g_stPvPublish);
astPubDeviceTable[5].sCategory       := '';

astPubDeviceTable[6].sTopic          := 'ess_meter';
astPubDeviceTable[6].pDeviceSrc       := ADR(g_stEssPublish.Devices);
astPubDeviceTable[6].nDeviceElemSize  := SIZEOF(ST_EssPublish_V1);
astPubDeviceTable[6].nDeviceCount     := UINT_TO_UDINT(GVL_PARAM.ESS_COUNT);
astPubDeviceTable[6].pStaging         := ADR(g_stEssPublish);
astPubDeviceTable[6].nStagingSize     := SIZEOF(g_stEssPublish);
astPubDeviceTable[6].sCategory       := '';

astPubDeviceTable[7].sTopic          := 'temperature_sensor';
astPubDeviceTable[7].pDeviceSrc       := ADR(g_stTempPublish.Devices);
astPubDeviceTable[7].nDeviceElemSize  := SIZEOF(ST_TempPublish_V1);
astPubDeviceTable[7].nDeviceCount     := UINT_TO_UDINT(GVL_PARAM.TEMP_COUNT);
astPubDeviceTable[7].pStaging         := ADR(g_stTempPublish);
astPubDeviceTable[7].nStagingSize     := SIZEOF(g_stTempPublish);
astPubDeviceTable[7].sCategory       := '';

astPubDeviceTable[8].sTopic          := 'airconditioner'; //공조기
astPubDeviceTable[8].pDeviceSrc       := ADR(g_stAirConditionerPublish.Devices);
astPubDeviceTable[8].nDeviceElemSize  := SIZEOF(ST_AirConditionerPublish_V1);
astPubDeviceTable[8].nDeviceCount     := UINT_TO_UDINT(GVL_PARAM.AIR_CONDITIONER_COUNT);
astPubDeviceTable[8].pStaging         := ADR(g_stAirConditionerPublish);
astPubDeviceTable[8].nStagingSize     := SIZEOF(g_stAirConditionerPublish);
astPubDeviceTable[8].sCategory       := '';

astPubDeviceTable[9].sTopic := 'ups';
astPubDeviceTable[9].sCategory := '';
astPubDeviceTable[9].pDeviceSrc := ADR(g_stUpsPublish.Devices);
astPubDeviceTable[9].nDeviceElemSize := SIZEOF(ST_UpsPublish_V1);
astPubDeviceTable[9].nDeviceCount := SEL(GVL_MQTT.UPS_REPORT_ENABLED,UDINT#0,UINT_TO_UDINT(GVL_PARAM.UPS_COUNT));
astPubDeviceTable[9].pStaging := ADR(g_stUpsPublish);
astPubDeviceTable[9].nStagingSize := SIZEOF(g_stUpsPublish);
astPubDeviceTable[10].sTopic := 'module';
astPubDeviceTable[10].sCategory := '';
astPubDeviceTable[10].pDeviceSrc := ADR(g_stModulePublish.Devices);
astPubDeviceTable[10].nDeviceElemSize := SIZEOF(ST_ModulePublish_V1);
astPubDeviceTable[10].nDeviceCount := SEL(GVL_MQTT.MODULE_REPORT_ENABLED,UDINT#0,UINT_TO_UDINT(GVL_PARAM.BAT_MODULE_COUNT));
astPubDeviceTable[10].pStaging := ADR(g_stModulePublish);
astPubDeviceTable[10].nStagingSize := SIZEOF(g_stModulePublish);
astPubDeviceTable[11].sTopic := 'imd'; // IMD 절연감시
astPubDeviceTable[11].sCategory := '';
astPubDeviceTable[11].pDeviceSrc := ADR(g_stImdPublish.Devices);
astPubDeviceTable[11].nDeviceElemSize := SIZEOF(ST_ImdPublish_V1);
astPubDeviceTable[11].nDeviceCount := SEL(GVL_MQTT.IMD_REPORT_ENABLED,UDINT#0,UINT_TO_UDINT(GVL_PARAM.IMD_COUNT));
astPubDeviceTable[11].pStaging := ADR(g_stImdPublish);
astPubDeviceTable[11].nStagingSize := SIZEOF(g_stImdPublish);
astPubDeviceTable[12].sTopic := 'fire_detector'; // 화재감지기 (OffGas 양식, 이름 잠정)
astPubDeviceTable[12].sCategory := '';
astPubDeviceTable[12].pDeviceSrc := ADR(g_stFirePublish.Devices);
astPubDeviceTable[12].nDeviceElemSize := SIZEOF(ST_FirePublish_V1);
astPubDeviceTable[12].nDeviceCount := SEL(GVL_MQTT.FIRE_REPORT_ENABLED,UDINT#0,UINT_TO_UDINT(GVL_PARAM.FIRE_COUNT));
astPubDeviceTable[12].pStaging := ADR(g_stFirePublish);
astPubDeviceTable[12].nStagingSize := SIZEOF(g_stFirePublish);
astPubConfigTable[4].sCategory := 'config';
astPubConfigTable[4].sTopic := 'ups';
astPubConfigTable[4].pDeviceSrc := ADR(g_stUpsConfigEcho.Records);
astPubConfigTable[4].nDeviceElemSize := SIZEOF(ST_UpsConfig_Rx);
astPubConfigTable[4].nDeviceCount := UINT_TO_UDINT(GVL_PARAM.UPS_COUNT);
astPubConfigTable[4].pStaging := ADR(g_stUpsConfigEcho);
astPubConfigTable[4].nStagingSize := SIZEOF(g_stUpsConfigEcho);

(* config echo *)
astPubConfigTable[1].sCategory       := 'config';
astPubConfigTable[1].sTopic          := 'pcs';
astPubConfigTable[1].pDeviceSrc      := ADR(g_stPcsConfigEcho.Records);
astPubConfigTable[1].nDeviceElemSize := SIZEOF(ST_PcsConfig_Rx);
astPubConfigTable[1].nDeviceCount    := UINT_TO_UDINT(GVL_PARAM.INSTALLED_PCS_COUNT);
astPubConfigTable[1].pStaging        := ADR(g_stPcsConfigEcho);
astPubConfigTable[1].nStagingSize    := SIZEOF(g_stPcsConfigEcho);

astPubConfigTable[2].sCategory       := 'config';
astPubConfigTable[2].sTopic          := 'bat';
astPubConfigTable[2].pDeviceSrc      := ADR(g_stBatConfigEcho.Records);
astPubConfigTable[2].nDeviceElemSize := SIZEOF(ST_BatConfig_Rx);
astPubConfigTable[2].nDeviceCount    := UINT_TO_UDINT(GVL_PARAM.BMS_COUNT);
astPubConfigTable[2].pStaging        := ADR(g_stBatConfigEcho);
astPubConfigTable[2].nStagingSize    := SIZEOF(g_stBatConfigEcho);

astPubConfigTable[3].sCategory       := 'config';
astPubConfigTable[3].sTopic          := 'protection';
astPubConfigTable[3].pDeviceSrc      := ADR(g_stProtectionConfigEcho.Record);	// [결함 12 수정 2026-11-04: 원래 g_stProtectionConfigWireIn]
astPubConfigTable[3].nDeviceElemSize := SIZEOF(ST_ProtectionConfig_Rx);
astPubConfigTable[3].nDeviceCount    := 1;
astPubConfigTable[3].pStaging        := ADR(g_stProtectionConfigEcho);
astPubConfigTable[3].nStagingSize    := SIZEOF(g_stProtectionConfigEcho);]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_InitSubscribeTable" Id="{f8d04db9-d709-41c1-9ad4-041df4b8cc96}">
      <Implementation>
        <ST><![CDATA[(*command*)
astSubCommandTable[1].sCategory   := 'command';
astSubCommandTable[1].sTopic      := 'pcs';
astSubCommandTable[1].bIndexed    := TRUE;
astSubCommandTable[1].pDestArray  := ADR(g_astPcsCommand);
astSubCommandTable[1].nElementSize:= SIZEOF(ST_MqttCommand_Rx);
astSubCommandTable[1].nDeviceCapacity    := UINT_TO_UDINT(GVL_PARAM.PCS_COUNT);
astSubCommandTable[1].pRxBuffer      := ADR(anRxPcsCommand);
astSubCommandTable[1].nRxBufferSize  := SIZEOF(anRxPcsCommand);
astSubCommandTable[1].nMaxRecords     := (SIZEOF(anRxPcsCommand) - SIZEOF(ST_MqttCommandHeader)) / SIZEOF(ST_MqttCommand_Rx);
astSubCommandTable[1].nIndexOffset    := 4;	// SequenceNumber 뒤 DeviceIndex [2026-11-12]

astSubCommandTable[2].sCategory   := 'command';
astSubCommandTable[2].sTopic      := 'bat';
astSubCommandTable[2].bIndexed    := TRUE;
astSubCommandTable[2].pDestArray  := ADR(g_astBatCommand);
astSubCommandTable[2].nElementSize:= SIZEOF(ST_MqttCommand_Rx);
astSubCommandTable[2].nDeviceCapacity    := UINT_TO_UDINT(GVL_PARAM.BMS_COUNT);
astSubCommandTable[2].pRxBuffer      := ADR(anRxBatCommand);
astSubCommandTable[2].nRxBufferSize  := SIZEOF(anRxBatCommand);
astSubCommandTable[2].nMaxRecords     := (SIZEOF(anRxBatCommand) - SIZEOF(ST_MqttCommandHeader)) / SIZEOF(ST_MqttCommand_Rx);
astSubCommandTable[2].nIndexOffset    := 4;

astSubCommandTable[3].sCategory   := 'command';
astSubCommandTable[3].sTopic      := 'ups';
astSubCommandTable[3].bIndexed    := TRUE;
astSubCommandTable[3].pDestArray  := ADR(g_astUpsCommand);
astSubCommandTable[3].nElementSize:= SIZEOF(ST_MqttCommand_Rx);
astSubCommandTable[3].nDeviceCapacity    := UINT_TO_UDINT(GVL_PARAM.UPS_COUNT);
astSubCommandTable[3].pRxBuffer      := ADR(anRxUpsCommand);
astSubCommandTable[3].nRxBufferSize  := SIZEOF(anRxUpsCommand);
astSubCommandTable[3].nMaxRecords     := (SIZEOF(anRxUpsCommand) - SIZEOF(ST_MqttCommandHeader)) / SIZEOF(ST_MqttCommand_Rx);
astSubCommandTable[3].nIndexOffset    := 4;
// UPS 번호도 1부터: F_MqttDistribute.DEVICE_ID_BASE가 모든 토픽에 적용 (원래 여기서 nDeviceIdBase := 1) [1부터 2026-11-10]

astSubConfigTable[4].sCategory := 'config';
astSubConfigTable[4].sTopic := 'ups';
astSubConfigTable[4].bIndexed := TRUE;
astSubConfigTable[4].pDestArray := ADR(g_astUpsConfig);
astSubConfigTable[4].nElementSize := SIZEOF(ST_UpsConfig_Rx);
astSubConfigTable[4].nDeviceCapacity := UINT_TO_UDINT(GVL_PARAM.UPS_COUNT);
astSubConfigTable[4].pRxBuffer := ADR(g_stUpsConfigWireIn);
astSubConfigTable[4].nRxBufferSize := SIZEOF(g_stUpsConfigWireIn);
astSubConfigTable[4].nMaxRecords := UINT_TO_UDINT(GVL_PARAM.UPS_COUNT);
// UPS DeviceId 1부터: DEVICE_ID_BASE 적용 (원래 nDeviceIdBase := 1) [1부터 2026-11-10]

(*config*)
astSubConfigTable[1].sCategory   := 'config';
astSubConfigTable[1].sTopic      := 'pcs';
astSubConfigTable[1].bIndexed    := TRUE;
astSubConfigTable[1].pDestArray  := ADR(g_astPcsConfig);
astSubConfigTable[1].nElementSize:= SIZEOF(ST_PcsConfig_Rx);
astSubConfigTable[1].nDeviceCapacity    := UINT_TO_UDINT(GVL_PARAM.PCS_COUNT);
astSubConfigTable[1].pRxBuffer      := ADR(g_stPcsConfigWireIn);
astSubConfigTable[1].nRxBufferSize  := SIZEOF(g_stPcsConfigWireIn);
astSubConfigTable[1].nMaxRecords		:=(SIZEOF(g_stPcsConfigWireIn) - SIZEOF(ST_MqttCommandHeader)) / SIZEOF(ST_PcsConfig_Rx);

astSubConfigTable[2].sCategory   := 'config';
astSubConfigTable[2].sTopic      := 'bat';
astSubConfigTable[2].bIndexed    := TRUE;
astSubConfigTable[2].pDestArray  := ADR(g_astBatConfig);
astSubConfigTable[2].nElementSize:= SIZEOF(ST_BatConfig_Rx);
astSubConfigTable[2].nDeviceCapacity    := UINT_TO_UDINT(GVL_PARAM.BMS_COUNT);
astSubConfigTable[2].pRxBuffer      := ADR(g_stBatConfigWireIn);
astSubConfigTable[2].nRxBufferSize  := SIZEOF(g_stBatConfigWireIn);
astSubConfigTable[2].nMaxRecords		:=(SIZEOF(g_stBatConfigWireIn) - SIZEOF(ST_MqttCommandHeader)) / SIZEOF(ST_BatConfig_Rx);

astSubConfigTable[3].sCategory   := 'config';
astSubConfigTable[3].sTopic      := 'protection';
astSubConfigTable[3].bIndexed    := FALSE;		// DeviceIndex 없는 단일 레코드
astSubConfigTable[3].pDestArray  := ADR(g_stProtectionConfig);
astSubConfigTable[3].nElementSize:= SIZEOF(ST_ProtectionConfig_Rx);
astSubConfigTable[3].nDeviceCapacity    := 1;
astSubConfigTable[3].pRxBuffer      := ADR(g_stProtectionConfigWireIn);	// [결함 12 수정 2026-11-04: pcs·bat처럼 수신 버퍼 = WireIn (헤더 Location·UserName을 echo에 씀). 원래 ADR(anRxProtectionConfig)]
astSubConfigTable[3].nRxBufferSize  := SIZEOF(g_stProtectionConfigWireIn);	// [결함 12 수정 2026-11-04: 원래 SIZEOF(anRxProtectionConfig)]
astSubConfigTable[3].nMaxRecords     := (SIZEOF(g_stProtectionConfigWireIn) - SIZEOF(ST_MqttCommandHeader)) / SIZEOF(ST_ProtectionConfig_Rx);	// [결함 12 수정 2026-11-04: 원래 SIZEOF(anRxProtectionConfig)] // 결과적으로 1]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_MakeTimeStamp" Id="{1af242ef-6411-4b93-af32-ebb88dd51b0f}">
      <Implementation>
        <ST><![CDATA[(* 현지 시각 → '2024-09-04 11:11:11.123' (F_MqttTimeText).
   같이 현지 − UTC 차이를 구해 둔다 (로거 시각을 현지 시각으로 바꿀 때). 시간대는 15분 단위라 반올림.
   현지 시각을 아직 못 얻었으면(bValid FALSE) 지난 값 유지 *)
IF fbLocalTime.bValid THEN
	sTimeStamp := F_MqttTimeText(fbLocalTime.systemTime);

	stLocalFileTime := SYSTEMTIME_TO_FILETIME(fbLocalTime.systemTime);
	MEMCPY(destAddr := ADR(nLocalFileTime), srcAddr := ADR(stLocalFileTime), n := SIZEOF(nLocalFileTime));
	nOffsetRaw := ULINT_TO_LINT(nLocalFileTime) - ULINT_TO_LINT(F_GetSystemTime());
	IF nOffsetRaw >= 0 THEN
		nUtcOffset := ((nOffsetRaw + OFFSET_STEP / 2) / OFFSET_STEP) * OFFSET_STEP;
	ELSE
		nUtcOffset := -((((-nOffsetRaw) + OFFSET_STEP / 2) / OFFSET_STEP) * OFFSET_STEP);
	END_IF
	bUtcOffsetValid := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_MapPublishHeader" Id="{43a6d3ec-4259-45b6-9b1f-32caa9ccc581}">
      <Implementation>
        <ST><![CDATA[g_stPmsPublish.Header.HeaderVersion := GVL_MQTT.HEADER_VERSION;
g_stPmsPublish.Header.DeviceVersion := GVL_MQTT.DEVICE_VERSION;
g_stPmsPublish.Header.SiteId        := i_stSet.nSiteId;
g_stPmsPublish.Header.DeviceCount   := 1;
g_stPmsPublish.Header.TimeStamp     := sTimeStamp;

g_stPcsPublish.Header.HeaderVersion := GVL_MQTT.HEADER_VERSION;
g_stPcsPublish.Header.DeviceVersion := GVL_MQTT.DEVICE_VERSION;
g_stPcsPublish.Header.SiteId        := i_stSet.nSiteId;
g_stPcsPublish.Header.DeviceCount   := UINT_TO_UDINT(GVL_PARAM.PCS_COUNT);
g_stPcsPublish.Header.TimeStamp     := sTimeStamp;

g_stBatPublish.Header.HeaderVersion := GVL_MQTT.HEADER_VERSION;
g_stBatPublish.Header.DeviceVersion := GVL_MQTT.DEVICE_VERSION;
g_stBatPublish.Header.SiteId        := i_stSet.nSiteId;
g_stBatPublish.Header.DeviceCount   := UINT_TO_UDINT(GVL_PARAM.BMS_COUNT);
g_stBatPublish.Header.TimeStamp     := sTimeStamp;

g_stRackPublish.Header.HeaderVersion :=GVL_MQTT.HEADER_VERSION;
g_stRackPublish.Header.DeviceVersion := GVL_MQTT.DEVICE_VERSION;
g_stRackPublish.Header.SiteId        := i_stSet.nSiteId;
g_stRackPublish.Header.DeviceCount   := UINT_TO_UDINT(GVL_PARAM.RACK_COUNT);
g_stRackPublish.Header.TimeStamp     := sTimeStamp;

g_stPvPublish.Header.HeaderVersion :=GVL_MQTT.HEADER_VERSION;
g_stPvPublish.Header.DeviceVersion := GVL_MQTT.DEVICE_VERSION;
g_stPvPublish.Header.SiteId        := i_stSet.nSiteId;
g_stPvPublish.Header.DeviceCount   := UINT_TO_UDINT(GVL_PARAM.PV_COUNT);
g_stPvPublish.Header.TimeStamp     := sTimeStamp;

g_stEssPublish.Header.HeaderVersion :=GVL_MQTT.HEADER_VERSION;
g_stEssPublish.Header.DeviceVersion := GVL_MQTT.DEVICE_VERSION;
g_stEssPublish.Header.SiteId        := i_stSet.nSiteId;
g_stEssPublish.Header.DeviceCount   := UINT_TO_UDINT(GVL_PARAM.ESS_COUNT);
g_stEssPublish.Header.TimeStamp     := sTimeStamp;

g_stTempPublish.Header.HeaderVersion :=GVL_MQTT.HEADER_VERSION;
g_stTempPublish.Header.DeviceVersion := GVL_MQTT.DEVICE_VERSION;
g_stTempPublish.Header.SiteId        := i_stSet.nSiteId;
g_stTempPublish.Header.DeviceCount   := UINT_TO_UDINT(GVL_PARAM.TEMP_COUNT);
g_stTempPublish.Header.TimeStamp     := sTimeStamp;

g_stAirConditionerPublish.Header.HeaderVersion := GVL_MQTT.HEADER_VERSION;
g_stAirConditionerPublish.Header.DeviceVersion := GVL_MQTT.DEVICE_VERSION;
g_stAirConditionerPublish.Header.SiteId        := i_stSet.nSiteId;
g_stAirConditionerPublish.Header.DeviceCount   := UINT_TO_UDINT(GVL_PARAM.AIR_CONDITIONER_COUNT);
g_stAirConditionerPublish.Header.TimeStamp     := sTimeStamp;

g_stUpsPublish.Header.HeaderVersion:=GVL_MQTT.HEADER_VERSION;
g_stUpsPublish.Header.DeviceVersion:=GVL_MQTT.DEVICE_VERSION;
g_stUpsPublish.Header.SiteId:=i_stSet.nSiteId;
g_stUpsPublish.Header.DeviceCount:=UINT_TO_UDINT(GVL_PARAM.UPS_COUNT);
g_stUpsPublish.Header.TimeStamp:=sTimeStamp;
g_stModulePublish.Header.HeaderVersion:=GVL_MQTT.HEADER_VERSION;
g_stModulePublish.Header.DeviceVersion:=GVL_MQTT.DEVICE_VERSION;
g_stModulePublish.Header.SiteId:=i_stSet.nSiteId;
g_stModulePublish.Header.DeviceCount:=UINT_TO_UDINT(GVL_PARAM.BAT_MODULE_COUNT);
g_stModulePublish.Header.TimeStamp:=sTimeStamp;
g_stImdPublish.Header.HeaderVersion:=GVL_MQTT.HEADER_VERSION;
g_stImdPublish.Header.DeviceVersion:=GVL_MQTT.DEVICE_VERSION;
g_stImdPublish.Header.SiteId:=i_stSet.nSiteId;
g_stImdPublish.Header.DeviceCount:=UINT_TO_UDINT(GVL_PARAM.IMD_COUNT);
g_stImdPublish.Header.TimeStamp:=sTimeStamp;
g_stFirePublish.Header.HeaderVersion:=GVL_MQTT.HEADER_VERSION;
g_stFirePublish.Header.DeviceVersion:=GVL_MQTT.DEVICE_VERSION;
g_stFirePublish.Header.SiteId:=i_stSet.nSiteId;
g_stFirePublish.Header.DeviceCount:=UINT_TO_UDINT(GVL_PARAM.FIRE_COUNT);
g_stFirePublish.Header.TimeStamp:=sTimeStamp;
g_stUpsConfigEcho.Header.HeaderVersion:=GVL_MQTT.HEADER_VERSION;
g_stUpsConfigEcho.Header.CommandVersion:=GVL_MQTT.COMMAND_VERSION;
g_stUpsConfigEcho.Header.DeviceCount:=UINT_TO_UDINT(GVL_PARAM.UPS_COUNT);
g_stUpsConfigEcho.Header.SiteID:=i_stSet.nSiteId;
g_stUpsConfigEcho.Header.Location:=g_stUpsConfigWireIn.Header.Location;
g_stUpsConfigEcho.Header.UserName:=g_stUpsConfigWireIn.Header.UserName;
g_stUpsConfigEcho.Header.TimeStamp:=sTimeStamp;
MEMCPY(destAddr:=ADR(g_stUpsConfigEcho.Records),srcAddr:=ADR(g_astUpsConfig),n:=SIZEOF(g_astUpsConfig));

(* --- config echo (PCS) --- *)
g_stPcsConfigEcho.Header.HeaderVersion  := GVL_MQTT.HEADER_VERSION;
g_stPcsConfigEcho.Header.CommandVersion := GVL_MQTT.COMMAND_VERSION;
g_stPcsConfigEcho.Header.DeviceCount    := UINT_TO_UDINT(GVL_PARAM.PCS_COUNT);
g_stPcsConfigEcho.Header.Location       := g_stPcsConfigWireIn.Header.Location;	// 받은 값 그대로
g_stPcsConfigEcho.Header.SiteID         := i_stSet.nSiteId;
g_stPcsConfigEcho.Header.UserName       := g_stPcsConfigWireIn.Header.UserName;	// 받은 값 그대로
g_stPcsConfigEcho.Header.TimeStamp      := sTimeStamp;
// [9-21 수정 2026-11-04: 받은 값 대신 실제 반영된 설정을 echo (MAIN FB_EmsConfigApply → GVL_IF → PRG_Mqtt). 아직 없으면 받은 값. 원래 이 줄만:
//   MEMCPY(destAddr := ADR(g_stPcsConfigEcho.Records), srcAddr := ADR(g_astPcsConfig), n := SIZEOF(g_astPcsConfig));]
IF g_bConfigApplied THEN
	MEMCPY(destAddr := ADR(g_stPcsConfigEcho.Records), srcAddr := ADR(g_astPcsConfigApplied), n := SIZEOF(g_astPcsConfigApplied));
ELSE
	MEMCPY(destAddr := ADR(g_stPcsConfigEcho.Records), srcAddr := ADR(g_astPcsConfig), n := SIZEOF(g_astPcsConfig));
END_IF

(* --- config echo (BAT) --- *)
g_stBatConfigEcho.Header.HeaderVersion  := GVL_MQTT.HEADER_VERSION;
g_stBatConfigEcho.Header.CommandVersion := GVL_MQTT.COMMAND_VERSION;
g_stBatConfigEcho.Header.DeviceCount    := UINT_TO_UDINT(GVL_PARAM.BMS_COUNT);
g_stBatConfigEcho.Header.Location       := g_stBatConfigWireIn.Header.Location;
g_stBatConfigEcho.Header.SiteID         := i_stSet.nSiteId;
g_stBatConfigEcho.Header.UserName       := g_stBatConfigWireIn.Header.UserName;
g_stBatConfigEcho.Header.TimeStamp      := sTimeStamp;
// [9-21 수정 2026-11-04: 받은 값 대신 실제 반영된 설정을 echo (MAIN FB_EmsConfigApply → GVL_IF → PRG_Mqtt). 아직 없으면 받은 값. 원래 이 줄만:
//   MEMCPY(destAddr := ADR(g_stBatConfigEcho.Records), srcAddr := ADR(g_astBatConfig), n := SIZEOF(g_astBatConfig));]
IF g_bConfigApplied THEN
	MEMCPY(destAddr := ADR(g_stBatConfigEcho.Records), srcAddr := ADR(g_astBatConfigApplied), n := SIZEOF(g_astBatConfigApplied));
ELSE
	MEMCPY(destAddr := ADR(g_stBatConfigEcho.Records), srcAddr := ADR(g_astBatConfig), n := SIZEOF(g_astBatConfig));
END_IF

(* --- config echo (Protection) --- [결함 12 수정 2026-11-04: 추가] *)
g_stProtectionConfigEcho.Header.HeaderVersion  := GVL_MQTT.HEADER_VERSION;
g_stProtectionConfigEcho.Header.CommandVersion := GVL_MQTT.COMMAND_VERSION;
g_stProtectionConfigEcho.Header.DeviceCount    := 1;
g_stProtectionConfigEcho.Header.Location       := g_stProtectionConfigWireIn.Header.Location;
g_stProtectionConfigEcho.Header.SiteID         := i_stSet.nSiteId;
g_stProtectionConfigEcho.Header.UserName       := g_stProtectionConfigWireIn.Header.UserName;
g_stProtectionConfigEcho.Header.TimeStamp      := sTimeStamp;
g_stProtectionConfigEcho.Record                := g_stProtectionConfig;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_PublishLogger" Id="{b7e3072c-8a06-4842-8a63-8e6b61bcd6a5}">
      <Implementation>
        <ST><![CDATA[(* 로거: 쓰는 브로커마다 다음 이벤트 1건씩 (발생할 때만, QoS 1). 보냈으면 다음 번호로.
   접속이 끊긴 브로커는 큐에 남은 것을 접속한 뒤 이어서 보냄 (LOGGER_QUEUE칸보다 밀리면 fbLogger.q_nLost)
   이중화: Active만 보냄 (i_bPublish, 장치 토픽과 같음). 대기 PLC의 로그는 쌓지 않고 버림:
   Active가 된 뒤 옛 로그를 한꺼번에 보내거나, 두 PLC가 같은 로그를 이중으로 보내지 않게 *)
IF NOT i_bPublish THEN
	anLoggerNext[1] := fbLogger.q_nReceived + 1;
	anLoggerNext[2] := fbLogger.q_nReceived + 1;
	anLoggerNext[3] := fbLogger.q_nReceived + 1;
	RETURN;
END_IF
IF i_stSet.stCloud.bUse THEN
	IF fbLogger.M_GetPacket(i_nSiteId := i_stSet.nSiteId, iq_nNext := anLoggerNext[1], iq_stPacket := stLoggerPacket) THEN
		IF fbCloudPub.M_PublishLogger(i_pPayload := ADR(stLoggerPacket), i_nSize := SIZEOF(stLoggerPacket)) THEN
			anLoggerNext[1] := anLoggerNext[1] + 1;
		END_IF
	END_IF
END_IF
IF i_stSet.stLocal.bUse THEN
	IF fbLogger.M_GetPacket(i_nSiteId := i_stSet.nSiteId, iq_nNext := anLoggerNext[2], iq_stPacket := stLoggerPacket) THEN
		IF fbLocalPub.M_PublishLogger(i_pPayload := ADR(stLoggerPacket), i_nSize := SIZEOF(stLoggerPacket)) THEN
			anLoggerNext[2] := anLoggerNext[2] + 1;
		END_IF
	END_IF
END_IF
IF i_stSet.stAzure.bUse THEN
	IF fbLogger.M_GetPacket(i_nSiteId := i_stSet.nSiteId, iq_nNext := anLoggerNext[3], iq_stPacket := stLoggerPacket) THEN
		IF fbAzurePub.M_PublishLogger(i_pPayload := ADR(stLoggerPacket), i_nSize := SIZEOF(stLoggerPacket)) THEN
			anLoggerNext[3] := anLoggerNext[3] + 1;
		END_IF
	END_IF
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_MergeRxCount" Id="{db2b0424-2885-466d-b039-4cf9df1c0cd2}">
      <Implementation>
        <ST><![CDATA[(* 브로커 3개 중 어디서든 새로 받은 토픽의 TimeStamp·횟수를 GVL_MQTT에 반영 *)
FOR i := 1 TO GVL_MQTT.COMMAND_TOPIC_COUNT DO
	IF fbCloudSub.q_anCmdRxCount[i] <> anPrevCmdCount[1, i] THEN
		anPrevCmdCount[1, i]	:= fbCloudSub.q_anCmdRxCount[i];
		g_asCmdRxTime[i]		:= fbCloudSub.q_asCmdRxTime[i];
		g_anCmdRxCount[i]		:= g_anCmdRxCount[i] + 1;
	END_IF
	IF fbLocalSub.q_anCmdRxCount[i] <> anPrevCmdCount[2, i] THEN
		anPrevCmdCount[2, i]	:= fbLocalSub.q_anCmdRxCount[i];
		g_asCmdRxTime[i]		:= fbLocalSub.q_asCmdRxTime[i];
		g_anCmdRxCount[i]		:= g_anCmdRxCount[i] + 1;
	END_IF
	IF fbAzureSub.q_anCmdRxCount[i] <> anPrevCmdCount[3, i] THEN
		anPrevCmdCount[3, i]	:= fbAzureSub.q_anCmdRxCount[i];
		g_asCmdRxTime[i]		:= fbAzureSub.q_asCmdRxTime[i];
		g_anCmdRxCount[i]		:= g_anCmdRxCount[i] + 1;
	END_IF
END_FOR
FOR i := 1 TO GVL_MQTT.CONFIG_TOPIC_COUNT DO
	IF fbCloudSub.q_anCfgRxCount[i] <> anPrevCfgCount[1, i] THEN
		anPrevCfgCount[1, i]	:= fbCloudSub.q_anCfgRxCount[i];
		g_asCfgRxTime[i]		:= fbCloudSub.q_asCfgRxTime[i];
		g_anCfgRxRecords[i]		:= fbCloudSub.q_anCfgRxRecords[i];	// [21번 수정 2026-11-09]
		g_anCfgRxCount[i]		:= g_anCfgRxCount[i] + 1;
	END_IF
	IF fbLocalSub.q_anCfgRxCount[i] <> anPrevCfgCount[2, i] THEN
		anPrevCfgCount[2, i]	:= fbLocalSub.q_anCfgRxCount[i];
		g_asCfgRxTime[i]		:= fbLocalSub.q_asCfgRxTime[i];
		g_anCfgRxRecords[i]		:= fbLocalSub.q_anCfgRxRecords[i];	// [21번 수정 2026-11-09]
		g_anCfgRxCount[i]		:= g_anCfgRxCount[i] + 1;
	END_IF
	IF fbAzureSub.q_anCfgRxCount[i] <> anPrevCfgCount[3, i] THEN
		anPrevCfgCount[3, i]	:= fbAzureSub.q_anCfgRxCount[i];
		g_asCfgRxTime[i]		:= fbAzureSub.q_asCfgRxTime[i];
		g_anCfgRxRecords[i]		:= fbAzureSub.q_anCfgRxRecords[i];	// [21번 수정 2026-11-09]
		g_anCfgRxCount[i]		:= g_anCfgRxCount[i] + 1;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Action>
                          </POU>
</TcPlcObject>