<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_ImdPublishData" Id="{fb7a1abb-b8f0-4721-9532-9d766f21b43f}">
    <Declaration><![CDATA[(* EMS로 보내는 IMD MQTT 패킷 전체 (토픽 imd). 바이너리 구조라 필드 순서를 바꾸면 안 된다. 2026-11-09 *)
{attribute 'pack_mode' := '1'}
TYPE ST_ImdPublishData :
STRUCT
	Header		: ST_MqttHeader;									// MQTT 공통 헤더
	Devices		: ARRAY[0..GVL_PARAM.IMD_COUNT-1] OF ST_ImdPublish_V1;	// IMD별 데이터
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>