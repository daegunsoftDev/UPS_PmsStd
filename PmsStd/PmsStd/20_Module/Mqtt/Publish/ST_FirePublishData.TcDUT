<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_FirePublishData" Id="{a2203641-9668-4f92-857c-53c1e31d0bc2}">
    <Declaration><![CDATA[(* EMS로 보내는 화재감지기 MQTT 패킷 전체 (토픽 fire_detector, 이름 잠정). 바이너리 구조라 필드 순서를 바꾸면 안 된다. 2026-11-10 *)
{attribute 'pack_mode' := '1'}
TYPE ST_FirePublishData :
STRUCT
	Header		: ST_MqttHeader;										// MQTT 공통 헤더
	Devices		: ARRAY[0..GVL_PARAM.FIRE_COUNT-1] OF ST_FirePublish_V1;	// 감지기별 데이터
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>