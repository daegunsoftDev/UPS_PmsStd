<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_ImdPublish_V1" Id="{cd44f801-9216-4304-93f4-915c34b84635}">
    <Declaration><![CDATA[(* EMS로 보내는 IMD 레코드 1개 (토픽 imd). 인터페이스\22. IMD.xlsx V1 그대로, 32 B. 바이너리 구조라 필드 순서를 바꾸면 안 된다. 2026-11-09 *)
{attribute 'pack_mode' := '1'}
TYPE ST_ImdPublish_V1 :
STRUCT
	DeviceIndex							: UDINT;	// 장치 번호 (1부터)
	Status								: UDINT;	// b0 통신에러, b1 Pre-Warning, b2 Warning, b3 Fault, b4 Alarm, b5 Internal test, b6 External test
	InsulationResistance				: REAL;		// 절연저항 kΩ
	DeviceErrorLocation					: REAL;		// 에러난 장치의 Device Number (Bender 항목, IMD1000은 0)
	InsulationResistanceFaultLocation	: REAL;		// 0~25 (+)극, 75~100 (-)극 (Bender 항목, IMD1000은 0)
	PreAlarmSettingValue				: UDINT;	// 사전경보 설정값 kΩ
	MainAlarmSettingValue				: UDINT;	// 주경보 설정값 kΩ
	Fault1								: UDINT;	// b0 SystemConnection Error, b1 ConnectionToEarth Error
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>