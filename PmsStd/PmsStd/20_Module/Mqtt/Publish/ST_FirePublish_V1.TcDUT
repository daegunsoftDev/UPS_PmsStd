<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_FirePublish_V1" Id="{99dc4a3d-2e40-41aa-86cb-7495a7a38a3e}">
    <Declaration><![CDATA[(* EMS로 보내는 화재감지기 레코드 1개 (토픽 fire_detector, 이름 잠정). 인터페이스 20. OffGas.xlsx V1과 같은 모양, 8 B. 2026-11-10 사용자 결정
   바이너리 구조라 필드 순서를 바꾸면 안 된다 *)
{attribute 'pack_mode' := '1'}
TYPE ST_FirePublish_V1 :
STRUCT
	DeviceIndex	: UDINT;	// 장치 번호 (1부터: 1 = TS-60, 2 = ASD-57. UPSstd 번호 규칙)
	Status		: UDINT;	// b0 통신 이상, b1 알람 (연기 등 감지), b2 고장 (감지기 자체 이상, 알 수 있을 때만)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>