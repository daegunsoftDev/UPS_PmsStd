<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15"><DUT Name="ST_UpsConfigWirePacket" Id="{6c40d777-2bb0-4f1e-be5f-d5f7de6873b7}"><Declaration><![CDATA[// EMS가 보내는 UPS 설정 MQTT 패킷 전체. 바이너리 구조라 필드 순서를 바꾸면 안 된다.
{attribute 'pack_mode' := '1'}
TYPE ST_UpsConfigWirePacket :
STRUCT
 Header : ST_MqttCommandHeader; // MQTT 공통 헤더
 Records : ARRAY[0..GVL_PARAM.UPS_COUNT-1] OF ST_UpsConfig_Rx; // UPS별 설정
END_STRUCT
END_TYPE]]></Declaration></DUT></TcPlcObject>