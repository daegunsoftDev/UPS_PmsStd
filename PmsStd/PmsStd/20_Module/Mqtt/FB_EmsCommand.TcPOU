<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_EmsCommand" Id="{7efb786e-24fd-4a7d-93c1-356649aeeb6e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_EmsCommand		// 명령 핸들러 (MqttTask): 받은 EMS command 레코드 → Std 명령 (PCS·BMS 상태 명령, 충전·방전 P 지령)
(* - 받은 레코드의 CommandType이 0이 아니면 한 번 해석하고 0으로 지운다 (같은 레코드를 다시 실행하지 않음)
   - 새 명령마다 번호(nSeq, anPcsPSeq)를 1 올린다. 받는 쪽(FB_SrcEms)은 번호 변화로 새 명령을 안다
   - 결과 q_stCmd는 지금까지 받은 명령 전체(마지막 값 유지). 바뀐 스캔에만 q_bChanged가 켜지고, PRG_Mqtt가 GVL_IF에 올린다
   - 받은 레코드 배열은 0부터 (GVL_MQTT 수신 배열 칸 = 레코드 DeviceIndex − 1, F_MqttDistribute.DEVICE_ID_BASE = 1). 결과는 Std 규칙대로 1부터 (칸 = DeviceIndex)
   - 이상한 값(NaN·무한대·절댓값이 MAX_VALUE 초과)의 P 지령은 버리고 센다. NaN은 비교하면 PLC가 멈추므로 F_IsFinite(비트)로 먼저 거른다. 정격 대비 상한은 코어 명령 필터(g_stCmdFilter)가 다시 거른다
   PCS CommandType: 1 Run, 2 Stop, 3 Standby, 4 충전(Value kW), 5 방전(Value kW), 6 비상정지, 7 리셋
   BAT CommandType: 1 접촉기 투입(Close), 2 개방(Open), 3 비상정지, 4 리셋, 11 랙 컨택터 닫기, 12 랙 컨택터 열기 (Value = 랙 번호 1~)
   5 시스템(랙 전체 40013) 연결, 6 차단, 7 충전 컨택터(40014) 닫기, 8 열기, 9 방전 컨택터(40015) 닫기, 10 열기 → astBatCtl [2026-11-13]
   (인터페이스 100.Command) *)
VAR_INPUT
	i_nRxCount			: UDINT;	// command 메시지 수신 누계 (브로커 3개 합)
END_VAR
VAR_IN_OUT
	iq_astPcsCommand	: ARRAY[0..GVL_PARAM.PCS_COUNT-1] OF ST_MqttCommand_Rx;	// GVL_MQTT.g_astPcsCommand
	iq_astBatCommand	: ARRAY[0..GVL_PARAM.BMS_COUNT-1] OF ST_MqttCommand_Rx;	// GVL_MQTT.g_astBatCommand
END_VAR
VAR_OUTPUT
	q_stCmd				: ST_IfEmsCmd;	// 지금까지 받은 명령
	q_bChanged			: BOOL;			// 이번 스캔에 q_stCmd가 바뀜
	q_nUnknownCount		: UDINT;		// 모르는 CommandType을 받은 횟수
	q_nBadValueCount	: UDINT;		// 이상한 값의 P 지령을 버린 횟수
END_VAR
VAR CONSTANT
	MAX_VALUE			: REAL := 1.0E7;	// kW. 이보다 크면 이상값
END_VAR
VAR
	_i					: UINT;
	_n					: UINT;
	_ePcsCmd			: E_PcsCmd;
	_eBatCmd			: E_BatCmd;
	_bP					: BOOL;
	_fP					: REAL;
	_bValueOk			: BOOL;		// 받은 Value가 보통 숫자 (NaN·무한대 아님)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[q_bChanged := FALSE;

// 명령이 없는 메시지도 '살아 있음'으로 셈
IF i_nRxCount <> q_stCmd.nRxCount THEN
	q_stCmd.nRxCount := i_nRxCount;
	q_bChanged := TRUE;
END_IF

(* PCS *)
FOR _i := 0 TO GVL_PARAM.PCS_COUNT - 1 DO
	IF iq_astPcsCommand[_i].CommandType <> 0 THEN
		_n := _i + 1;
		_ePcsCmd	:= E_PcsCmd.None;
		_bP			:= FALSE;
		_bValueOk	:= F_IsFinite(iq_astPcsCommand[_i].Value);	// NaN은 크기 비교·ABS 전에 비트로 거름 (비교하면 PLC가 멈춤)
		CASE iq_astPcsCommand[_i].CommandType OF
			1:	_ePcsCmd := E_PcsCmd.Run;
			2:	_ePcsCmd := E_PcsCmd.Stop;
			3:	_ePcsCmd := E_PcsCmd.Standby;
			4:	_bP := TRUE;	IF _bValueOk THEN _fP := -ABS(iq_astPcsCommand[_i].Value); END_IF	// 충전
			5:	_bP := TRUE;	IF _bValueOk THEN _fP := ABS(iq_astPcsCommand[_i].Value); END_IF		// 방전
			6:	_ePcsCmd := E_PcsCmd.EStop;
			7:	_ePcsCmd := E_PcsCmd.Reset;
		ELSE
			q_nUnknownCount := q_nUnknownCount + 1;
		END_CASE
		// P 지령 값 거르기: 보통 숫자가 아니거나 너무 크면 버림 (크기 비교는 보통 숫자일 때만)
		IF _bP THEN
			IF NOT _bValueOk THEN
				_bP := FALSE;
				q_nBadValueCount := q_nBadValueCount + 1;
			ELSIF ABS(iq_astPcsCommand[_i].Value) > MAX_VALUE THEN
				_bP := FALSE;
				q_nBadValueCount := q_nBadValueCount + 1;
			END_IF
		END_IF
		IF _ePcsCmd <> E_PcsCmd.None THEN
			q_stCmd.astPcs[_n].eCmd := _ePcsCmd;
			q_stCmd.astPcs[_n].nSeq := q_stCmd.astPcs[_n].nSeq + 1;
			q_bChanged := TRUE;
		END_IF
		IF _bP THEN
			q_stCmd.afPcsP[_n]		:= _fP;
			q_stCmd.anPcsPSeq[_n]	:= q_stCmd.anPcsPSeq[_n] + 1;
			q_bChanged := TRUE;
		END_IF
		iq_astPcsCommand[_i].CommandType := 0;		// 처리 완료
	END_IF
END_FOR

(* BAT (BMS) *)
FOR _i := 0 TO GVL_PARAM.BMS_COUNT - 1 DO
	IF iq_astBatCommand[_i].CommandType <> 0 THEN
		_n := _i + 1;
		_eBatCmd := E_BatCmd.None;
		CASE iq_astBatCommand[_i].CommandType OF
			1:	_eBatCmd := E_BatCmd.Close;
			2:	_eBatCmd := E_BatCmd.Open;
			3:	_eBatCmd := E_BatCmd.EStop;
			4:	_eBatCmd := E_BatCmd.Reset;
			5..10:	// 컨택터 하나씩 (FB_BmsContactorCommand가 번호를 해석) [2026-11-13]
				q_stCmd.astBatCtl[_n].nSeq := q_stCmd.astBatCtl[_n].nSeq + 1;
				q_stCmd.astBatCtl[_n].nType := UDINT_TO_UINT(iq_astBatCommand[_i].CommandType);
				q_bChanged := TRUE;
			11, 12:	// 랙 컨택터 닫기·열기. Value = 랙 번호 (정수가 아니거나 범위 밖이면 0 → FB_BmsRackCommand가 거절)
				q_stCmd.astBatRack[_n].nSeq := q_stCmd.astBatRack[_n].nSeq + 1;
				q_stCmd.astBatRack[_n].bClose := iq_astBatCommand[_i].CommandType = 11;
				IF iq_astBatCommand[_i].Value >= 1.0 AND iq_astBatCommand[_i].Value <= 16.0
					AND iq_astBatCommand[_i].Value = UINT_TO_REAL(REAL_TO_UINT(iq_astBatCommand[_i].Value)) THEN
					q_stCmd.astBatRack[_n].nRack := REAL_TO_UINT(iq_astBatCommand[_i].Value);
				ELSE
					q_stCmd.astBatRack[_n].nRack := 0;
				END_IF
				q_bChanged := TRUE;
		ELSE
			q_nUnknownCount := q_nUnknownCount + 1;
		END_CASE
		IF _eBatCmd <> E_BatCmd.None THEN
			q_stCmd.astBat[_n].eCmd := _eBatCmd;
			q_stCmd.astBat[_n].nSeq := q_stCmd.astBat[_n].nSeq + 1;
			q_bChanged := TRUE;
		END_IF
		iq_astBatCommand[_i].CommandType := 0;		// 처리 완료
	END_IF
END_FOR]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>