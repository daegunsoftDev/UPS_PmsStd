<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_ProtBmsFault" Id="{ddaf93f1-c027-4a9c-9bb7-0cf70ad413a5}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ProtBmsFault EXTENDS FB_ModuleBase IMPLEMENTS I_ProtectionRule		// 표준 보호: BMS 고장 (범위 Bms): 통신이 있고 BMS가 고장을 알림. 기본 등록. 빼면 이 보호 없음. 현장마다 다르면 복사해 이름을 바꿔 그 칸에 대신 등록
VAR
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="M_Evaluate" Id="{2d3b3192-fd91-46f7-908f-089add5d9c5e}">
      <Declaration><![CDATA[METHOD M_Evaluate : BOOL		// 범위가 맞지 않게 등록되면 FALSE (보호 안 걸림)
VAR_INPUT
	i_stView	: ST_ProtView;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_Evaluate := i_stView.eScope = E_ProtScope.Bms AND i_stView.bInstalled AND i_stView.stBms.bComm AND i_stView.stBms.bFault;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>