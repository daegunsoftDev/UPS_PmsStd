<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_CmSchedule" Id="{524a8f1e-50ca-42db-b913-3691668ee427}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CmSchedule EXTENDS FB_CmTariffBase		// 제어 모드: 스케줄 (Messis SCHEDULE_MODE). 계절·요일 시간표의 P를 냄
// 맞는 칸 없음·휴일·시각 무효 → 0. 충전(-)은 그대로, 방전(+)은 방전 허용 시간·역송 방지 (공통 설정). 칸은 자정을 넘지 않음
VAR_INPUT
	i_stTable	: ST_CmScheduleSet;		// 시간표 (A_PassModuleSet이 GVL_PERSIST.g_stModuleSet.stCmSchedule을 매 스캔 넘김)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="M_Calc" Id="{aed45ab3-bea1-4a30-8c9d-9a0f31f0e3dd}">
      <Declaration><![CDATA[METHOD M_Calc : ST_CtrlModeOut
VAR_INPUT
	i_stView	: ST_CtrlModeView;
END_VAR
VAR
	fP		: REAL;
	nRsn	: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[fP := 0.0;
IF M_Begin(i_stView := i_stView) THEN
	M_SchedLookup(i_stTime := i_stView.stTime, iq_stTable := i_stTable);
	fP			:= M_SchedOut(i_stView := i_stView, q_nRsn => nRsn);
	q_nState	:= nRsn;
END_IF
M_Calc := M_Finish(i_fP := fP);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_CheckSet" Id="{b84f2a2e-ddfb-49f1-8cc9-d8983c0c9bf8}">
      <Declaration><![CDATA[METHOD M_CheckSet : WSTRING(63)]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_CheckSet := SUPER^.M_CheckSet();
IF M_CheckSet = "" THEN
	M_CheckSet := M_CheckTable(iq_stTable := i_stTable);
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>