<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_SocLimit" Id="{9425dde3-20da-40b9-a3a0-5e74a5c43c27}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_SocLimit EXTENDS FB_ModuleBase IMPLEMENTS I_BatLimitRule	// SOC 감발·차단·재개 마진 (버스 제한). 기본 SOC 정책 (Auto·Manual 기본 등록)
// 최대 SOC가 상한에 다가가면 충전 한도를, 최소 SOC가 하한에 다가가면 방전 한도를 줄이고, 한계에서 막음
// 막은 뒤에는 SOC가 재개 마진만큼 돌아와야 다시 허용. 다시 허용한 뒤 감발 구간을 지나는 동안 bResume (재개 램프율)
// 출력 한도만 냄 (장비 명령 없음). 한도가 0이면 그 방향 출력 0 = 대기
// nTarget 0 = 모든 버스를 한 인스턴스가 봄 (버스마다 상태를 따로 가짐)
VAR_INPUT
	i_stSet	: ST_SocLimitSet;	// 설정 (MAIN이 GVL_PERSIST.g_stModuleSet 칸을 매 스캔 넘김. 안 넘기면 기본값)
END_VAR
VAR
	(* 버스마다 상태 *)
	_abChgBlock	: ARRAY[1..GVL_PARAM.BAT_COUNT] OF BOOL;	// 충전 막음 (재개 마진 전까지 유지)
	_abDisBlock	: ARRAY[1..GVL_PARAM.BAT_COUNT] OF BOOL;	// 방전 막음
	_abChgResume	: ARRAY[1..GVL_PARAM.BAT_COUNT] OF BOOL;	// 충전 재개 중 (막음이 풀린 뒤 감발 구간)
	_abDisResume	: ARRAY[1..GVL_PARAM.BAT_COUNT] OF BOOL;
	_afChgRatio	: ARRAY[1..GVL_PARAM.BAT_COUNT] OF REAL;	// 진단: 충전 한도 비율 (1 = 안 줄임)
	_afDisRatio	: ARRAY[1..GVL_PARAM.BAT_COUNT] OF REAL;	// 진단: 방전 한도 비율
END_VAR
VAR CONSTANT
	RSN_CHG_DERATE	: UINT := 1;	// 상한 근처 충전 감발
	RSN_CHG_BLOCK	: UINT := 2;	// 상한 충전 막음
	RSN_DIS_DERATE	: UINT := 3;	// 하한 근처 방전 감발
	RSN_DIS_BLOCK	: UINT := 4;	// 하한 방전 막음
	RSN_SOC_INVALID	: UINT := 5;	// SOC 무효
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="M_Evaluate" Id="{24208b72-a843-48cb-946a-efea6772b3dc}">
      <Declaration><![CDATA[METHOD M_Evaluate : ST_BatLimitOut
VAR_INPUT
	i_stView	: ST_BatLimitView;
END_VAR
VAR
	b	: UINT;
	fChg	: REAL;	// 충전 한도 비율
	fDis	: REAL;	// 방전 한도 비율
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[b := i_stView.nBatGroup;
IF b < 1 OR b > GVL_PARAM.BAT_COUNT THEN
	RETURN;
END_IF
// SOC 무효: 상태를 풀고, 설정이면 충·방전 모두 막음
IF NOT i_stView.stSocMax.bValid OR NOT i_stView.stSocMin.bValid THEN
	_abChgBlock[b]	:= FALSE;
	_abDisBlock[b]	:= FALSE;
	_abChgResume[b]	:= FALSE;
	_abDisResume[b]	:= FALSE;
	_afChgRatio[b]	:= 1.0;
	_afDisRatio[b]	:= 1.0;
	IF i_stSet.bBlockOnInvalid THEN
		M_Evaluate.stP.bActive	:= TRUE;
		M_Evaluate.stP.fMax	:= 0.0;
		M_Evaluate.stP.fMin	:= 0.0;
		M_Evaluate.stP.nReason	:= RSN_SOC_INVALID;
		_afChgRatio[b]	:= 0.0;
		_afDisRatio[b]	:= 0.0;
	END_IF
	RETURN;
END_IF

// 충전: 최대 SOC 기준
IF i_stView.stSocMax.fValue >= i_stSet.fSocMax THEN
	_abChgBlock[b]	:= TRUE;
	_abChgResume[b]	:= FALSE;
ELSIF _abChgBlock[b] AND i_stView.stSocMax.fValue <= i_stSet.fSocMax - i_stSet.fResumeMargin THEN
	_abChgBlock[b]	:= FALSE;
	_abChgResume[b]	:= TRUE;
END_IF
fChg := 0.0;
IF NOT _abChgBlock[b] THEN
	fChg := F_SocDerate(i_fSoc := i_stView.stSocMax.fValue, i_fLimit := i_stSet.fSocMax, i_fBand := i_stSet.fBand, i_bUpper := TRUE);
END_IF
IF fChg >= 1.0 THEN
	_abChgResume[b] := FALSE;
END_IF

// 방전: 최소 SOC 기준
IF i_stView.stSocMin.fValue <= i_stSet.fSocMin THEN
	_abDisBlock[b]	:= TRUE;
	_abDisResume[b]	:= FALSE;
ELSIF _abDisBlock[b] AND i_stView.stSocMin.fValue >= i_stSet.fSocMin + i_stSet.fResumeMargin THEN
	_abDisBlock[b]	:= FALSE;
	_abDisResume[b]	:= TRUE;
END_IF
fDis := 0.0;
IF NOT _abDisBlock[b] THEN
	fDis := F_SocDerate(i_fSoc := i_stView.stSocMin.fValue, i_fLimit := i_stSet.fSocMin, i_fBand := i_stSet.fBand, i_bUpper := FALSE);
END_IF
IF fDis >= 1.0 THEN
	_abDisResume[b] := FALSE;
END_IF

_afChgRatio[b]	:= fChg;
_afDisRatio[b]	:= fDis;
M_Evaluate.bResume := _abChgResume[b] OR _abDisResume[b];
IF fChg < 1.0 OR fDis < 1.0 THEN
	M_Evaluate.stP.bActive	:= TRUE;
	M_Evaluate.stP.fMax	:= MAX(i_stView.fPDisMax, 0.0) * fDis;
	M_Evaluate.stP.fMin	:= -MAX(i_stView.fPChgMax, 0.0) * fChg;
	// 이유: 막음이 감발보다 먼저 (한 줄 제한이라 상·하한이 같은 이유를 가짐)
	IF _abDisBlock[b] THEN
		M_Evaluate.stP.nReason := RSN_DIS_BLOCK;
	ELSIF _abChgBlock[b] THEN
		M_Evaluate.stP.nReason := RSN_CHG_BLOCK;
	ELSIF fDis < 1.0 THEN
		M_Evaluate.stP.nReason := RSN_DIS_DERATE;
	ELSE
		M_Evaluate.stP.nReason := RSN_CHG_DERATE;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ReasonText" Id="{3356e403-93bb-4f43-8799-cfd5936152cd}">
      <Declaration><![CDATA[METHOD M_ReasonText : WSTRING(63)
VAR_INPUT
	i_nReason	: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE i_nReason OF
	RSN_CHG_DERATE:	M_ReasonText := "SOC 상한 근처 충전 감발";
	RSN_CHG_BLOCK:	M_ReasonText := "SOC 상한 충전 막음";
	RSN_DIS_DERATE:	M_ReasonText := "SOC 하한 근처 방전 감발";
	RSN_DIS_BLOCK:	M_ReasonText := "SOC 하한 방전 막음";
	RSN_SOC_INVALID:	M_ReasonText := "SOC 무효";
ELSE
	M_ReasonText := WCONCAT("이유 ", TO_WSTRING(i_nReason));
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_CheckSet" Id="{1448cb79-2551-4749-b11f-f90daf62a40a}">
      <Declaration><![CDATA[METHOD M_CheckSet : WSTRING(63)		// 설정 점검: SOC 상·하한, 감발 폭, 재개 마진]]></Declaration>
      <Implementation>
        <ST><![CDATA[// [9-21 수정 2026-11-04: 검사 규칙을 F_SocLimitSetErr로 옮김 (EMS config 반영 FB_EmsConfigApply와 같은 규칙을 씀). 원래:
//   M_CheckSet := "";
//   IF NOT (F_RealOk(i_stSet.fSocMin) AND F_RealOk(i_stSet.fSocMax) AND F_RealOk(i_stSet.fBand) AND F_RealOk(i_stSet.fResumeMargin)) THEN	// [결함 13 수정 2026-11-04]
//   	M_CheckSet := "SOC 설정 숫자 아님";
//   ELSIF i_stSet.fSocMin < 0.0 OR i_stSet.fSocMax > 100.0 OR i_stSet.fSocMin >= i_stSet.fSocMax THEN
//   	M_CheckSet := "SOC 상·하한 (0 ≤ 하한 < 상한 ≤ 100)";
//   ELSIF i_stSet.fBand < 0.0 OR i_stSet.fSocMin + i_stSet.fBand > i_stSet.fSocMax - i_stSet.fBand THEN
//   	M_CheckSet := "감발 폭 fBand (0 이상, 상·하한 사이)";
//   ELSIF i_stSet.fResumeMargin < 0.0 OR i_stSet.fSocMin + i_stSet.fResumeMargin >= i_stSet.fSocMax - i_stSet.fResumeMargin THEN
//   	M_CheckSet := "재개 마진 fResumeMargin (0 이상, 상·하한 사이)";
//   END_IF]
M_CheckSet := F_SocLimitSetErr(i_stSet);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>