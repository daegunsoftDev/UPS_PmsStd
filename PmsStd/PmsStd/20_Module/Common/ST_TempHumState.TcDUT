  <DUT Name="ST_TempHumState" Id="{a10fa598-15fc-417f-ab51-442995187d97}">
    <Declaration><![CDATA[(* 온습도계 읽은 값 (드라이버 q_stState → FB_RptTempHum → 토픽 temperature_sensor). 2026-11-09.
   ITGuard IE-SX·RADIONODE RN172 같이 씀 *)
TYPE ST_TempHumState :
STRUCT
	bValid		: BOOL;		// 통신 정상이고 센서 값이 유효
	fTemp		: REAL;		// 온도 ℃
	fHum		: REAL;		// 습도 %
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>