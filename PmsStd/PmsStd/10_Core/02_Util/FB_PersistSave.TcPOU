<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_PersistSave" Id="{5217ed24-3f41-40da-b720-d8d42801a8c2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PersistSave		// PERSISTENT 값을 파일에 저장: 설정이 바뀌면 잠시 뒤 바로, 그리고 주기마다 (PERSISTENT는 정상 종료 때만 저장되므로 직접 씀)
// GVL_PERSIST에 코어 운영 설정을 추가하면 여기 입출력·사본·A_CopyShadow·비교에도 추가한다 (안 넣으면 주기 저장만 됨)
// 현장 모듈 설정 묶음(g_stModuleSet)은 주소·크기로 받아 통째로 비교 → 현장에서 모듈 설정을 늘려도 여기는 안 고침
VAR_INPUT
	i_tPeriod		: TIME := T#60S;	// 주기 저장 (재기동 기록 시각처럼 계속 바뀌는 값)
	i_tSettle		: TIME := T#1S;		// 설정이 바뀐 뒤 이 시간 동안 더 안 바뀌면 저장 (연속 입력을 한 번에)
	i_bSaveNow		: BOOL;				// 바로 저장 요청 (상승 에지)
	i_pModuleSet	: PVOID;			// 현장 모듈 설정 묶음 주소 (ADR(GVL_PERSIST.g_stModuleSet)). 0 = 없음
	i_nModuleSetSize	: UDINT;		// 그 크기 (SIZEOF). GVL_PARAM.MODULE_SET_BYTES보다 크면 비교 안 함 (주기 저장만)
END_VAR
VAR_IN_OUT
	(* 바뀌면 바로 저장할 운영 설정 (GVL_PERSIST). 값은 바꾸지 않음 (VAR_IN_OUT: 저장할 메모리 주소를 비교에 씀) *)
	iq_aeOpMode		: ARRAY[1..GVL_PARAM.UNIT_COUNT] OF E_OpMode;
	iq_astGroupSet	: ARRAY[1..GVL_PARAM.GROUP_COUNT] OF ST_GroupSet;
	iq_astManualPolicy: ARRAY[1..GVL_PARAM.GROUP_COUNT] OF ST_ManualPolicy;
	iq_astSourceReg	: ARRAY[1..GVL_PARAM.SOURCE_COUNT] OF ST_SourceReg;
	iq_astLimitReg	: ARRAY[1..GVL_PARAM.LIMIT_COUNT] OF ST_ModuleReg;
	iq_astPermitReg	: ARRAY[1..GVL_PARAM.PERMIT_COUNT] OF ST_ModuleReg;
	iq_astCompReg	: ARRAY[1..GVL_PARAM.COMP_COUNT] OF ST_ModuleReg;
	iq_astRuleCfg	: ARRAY[1..GVL_PARAM.RULE_COUNT] OF ST_RuleCfg;
	iq_astOutputCfg	: ARRAY[1..GVL_PARAM.OUTPUT_COUNT] OF ST_OutputCfg;
	iq_astUnitRuleReg	: ARRAY[1..GVL_PARAM.UNIT_RULE_COUNT] OF ST_RuleTargetReg;
	iq_astBatRuleReg	: ARRAY[1..GVL_PARAM.BAT_RULE_COUNT] OF ST_RuleTargetReg;
	iq_stCmdFilter	: ST_CmdFilterSet;
	iq_stManualCmdSet	: ST_ManualCmdSet;
	iq_stSeqSet		: ST_SeqSet;
	iq_stBrokerWatch	: ST_BrokerWatchSet;	// [9번 수정 2026-11-09: 추가]
END_VAR
VAR_OUTPUT
	q_bBusy			: BOOL;
	q_bError		: BOOL;				// 마지막 저장 실패
	q_nErrorId		: UDINT;
	q_nSaveCount	: UDINT;			// 성공한 저장 횟수 (PLC 시작 후)
	q_bChangeWait	: BOOL;				// 설정이 바뀌어 저장 대기 중
	q_bModuleSetTooBig	: BOOL;			// 모듈 설정 묶음이 MODULE_SET_BYTES보다 큼: 바뀌어도 바로 저장 안 됨 (GVL_PARAM.MODULE_SET_BYTES를 늘림)
	q_bSetChanged	: BOOL;				// 바뀐 운영 설정을 저장하기 시작함 (1스캔, 기록용)
	q_sSetChanged	: WSTRING(63);		// 그때 바뀐 설정 이름 (마지막 저장 뒤 바뀐 것 모두, 길면 잘림)
END_VAR
VAR
	_fbWrite		: FB_WritePersistentData;
	_tonPeriod		: TON;
	_tonSettle		: TON;
	_rtSaveNow		: R_TRIG;
	_ftBusy			: F_TRIG;
	_bInit			: BOOL;
	_bPending		: BOOL;				// 저장해야 함 (진행 중인 저장이 끝나면 시작)
	_bStart			: BOOL;				// 저장 시작 (한 스캔)
	(* 지난 스캔 사본: 바뀜 확인용 *)
	_aeOpMode		: ARRAY[1..GVL_PARAM.UNIT_COUNT] OF E_OpMode;
	_astGroupSet	: ARRAY[1..GVL_PARAM.GROUP_COUNT] OF ST_GroupSet;
	_astManualPolicy: ARRAY[1..GVL_PARAM.GROUP_COUNT] OF ST_ManualPolicy;
	_astSourceReg	: ARRAY[1..GVL_PARAM.SOURCE_COUNT] OF ST_SourceReg;
	_astLimitReg	: ARRAY[1..GVL_PARAM.LIMIT_COUNT] OF ST_ModuleReg;
	_astPermitReg	: ARRAY[1..GVL_PARAM.PERMIT_COUNT] OF ST_ModuleReg;
	_astCompReg		: ARRAY[1..GVL_PARAM.COMP_COUNT] OF ST_ModuleReg;
	_astRuleCfg		: ARRAY[1..GVL_PARAM.RULE_COUNT] OF ST_RuleCfg;
	_astOutputCfg	: ARRAY[1..GVL_PARAM.OUTPUT_COUNT] OF ST_OutputCfg;
	_astUnitRuleReg	: ARRAY[1..GVL_PARAM.UNIT_RULE_COUNT] OF ST_RuleTargetReg;
	_astBatRuleReg	: ARRAY[1..GVL_PARAM.BAT_RULE_COUNT] OF ST_RuleTargetReg;
	_stCmdFilter	: ST_CmdFilterSet;
	_stManualCmdSet	: ST_ManualCmdSet;
	_stSeqSet		: ST_SeqSet;
	_stBrokerWatch	: ST_BrokerWatchSet;
	_abModuleSet	: ARRAY[0..GVL_PARAM.MODULE_SET_BYTES - 1] OF BYTE;	// 모듈 설정 묶음 사본
	_dwChanged		: DWORD;			// 마지막 저장 뒤 바뀐 설정 (비트 = M_ChangedText 순서)
END_VAR
VAR_TEMP
	bChanged		: BOOL;
	dwNow			: DWORD;			// 이번 스캔에 바뀐 설정
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 모듈 설정 묶음 크기 (첫 스캔 사본 복사보다 먼저: 크면 복사하지 않음)
q_bModuleSetTooBig := i_nModuleSetSize > GVL_PARAM.MODULE_SET_BYTES;

// 첫 스캔: 불러온 값을 기준으로 삼음 (저장 안 함)
IF NOT _bInit THEN
	A_CopyShadow();
	_bInit := TRUE;
END_IF

// 1) 운영 설정이 바뀌었는지 (사본과 메모리 비교)
dwNow := 0;
IF MEMCMP(ADR(iq_aeOpMode), ADR(_aeOpMode), SIZEOF(_aeOpMode)) <> 0 THEN dwNow := dwNow OR 16#00001; END_IF
IF MEMCMP(ADR(iq_astGroupSet), ADR(_astGroupSet), SIZEOF(_astGroupSet)) <> 0 THEN dwNow := dwNow OR 16#00002; END_IF
IF MEMCMP(ADR(iq_astManualPolicy), ADR(_astManualPolicy), SIZEOF(_astManualPolicy)) <> 0 THEN dwNow := dwNow OR 16#00004; END_IF
IF MEMCMP(ADR(iq_astSourceReg), ADR(_astSourceReg), SIZEOF(_astSourceReg)) <> 0 THEN dwNow := dwNow OR 16#00008; END_IF
IF MEMCMP(ADR(iq_astLimitReg), ADR(_astLimitReg), SIZEOF(_astLimitReg)) <> 0 THEN dwNow := dwNow OR 16#00010; END_IF
IF MEMCMP(ADR(iq_astPermitReg), ADR(_astPermitReg), SIZEOF(_astPermitReg)) <> 0 THEN dwNow := dwNow OR 16#00020; END_IF
IF MEMCMP(ADR(iq_astCompReg), ADR(_astCompReg), SIZEOF(_astCompReg)) <> 0 THEN dwNow := dwNow OR 16#00040; END_IF
IF MEMCMP(ADR(iq_astRuleCfg), ADR(_astRuleCfg), SIZEOF(_astRuleCfg)) <> 0 THEN dwNow := dwNow OR 16#00100; END_IF
IF MEMCMP(ADR(iq_astOutputCfg), ADR(_astOutputCfg), SIZEOF(_astOutputCfg)) <> 0 THEN dwNow := dwNow OR 16#00200; END_IF
IF MEMCMP(ADR(iq_astUnitRuleReg), ADR(_astUnitRuleReg), SIZEOF(_astUnitRuleReg)) <> 0 THEN dwNow := dwNow OR 16#00400; END_IF
IF MEMCMP(ADR(iq_astBatRuleReg), ADR(_astBatRuleReg), SIZEOF(_astBatRuleReg)) <> 0 THEN dwNow := dwNow OR 16#00800; END_IF
IF MEMCMP(ADR(iq_stCmdFilter), ADR(_stCmdFilter), SIZEOF(_stCmdFilter)) <> 0 THEN dwNow := dwNow OR 16#02000; END_IF
IF MEMCMP(ADR(iq_stManualCmdSet), ADR(_stManualCmdSet), SIZEOF(_stManualCmdSet)) <> 0 THEN dwNow := dwNow OR 16#04000; END_IF
IF MEMCMP(ADR(iq_stSeqSet), ADR(_stSeqSet), SIZEOF(_stSeqSet)) <> 0 THEN dwNow := dwNow OR 16#08000; END_IF
IF MEMCMP(ADR(iq_stBrokerWatch), ADR(_stBrokerWatch), SIZEOF(_stBrokerWatch)) <> 0 THEN dwNow := dwNow OR 16#20000; END_IF
IF i_pModuleSet <> 0 AND i_nModuleSetSize > 0 AND NOT q_bModuleSetTooBig THEN
	IF MEMCMP(i_pModuleSet, ADR(_abModuleSet), i_nModuleSetSize) <> 0 THEN dwNow := dwNow OR 16#10000; END_IF
END_IF
bChanged := dwNow <> 0;
_dwChanged := _dwChanged OR dwNow;
IF bChanged THEN
	A_CopyShadow();
	q_bChangeWait := TRUE;
	_tonSettle(IN := FALSE);		// 또 바뀌면 대기 시간을 다시 셈
END_IF
_tonSettle(IN := q_bChangeWait, PT := i_tSettle);

// 2) 저장할 때: 바뀐 뒤 잠잠해짐 / 요청 / 주기
_rtSaveNow(CLK := i_bSaveNow);
_tonPeriod(IN := NOT _tonPeriod.Q, PT := i_tPeriod);
q_bSetChanged := FALSE;
IF _tonSettle.Q OR _rtSaveNow.Q OR _tonPeriod.Q THEN
	_bPending		:= TRUE;
	q_bChangeWait	:= FALSE;
	IF _dwChanged <> 0 THEN		// 바뀐 설정을 저장함 → 기록 (FB_EventLog)
		q_bSetChanged	:= TRUE;
		q_sSetChanged	:= M_ChangedText(_dwChanged);
		_dwChanged		:= 0;
	END_IF
END_IF

// 3) 저장 (진행 중이면 끝난 뒤 한 번 더)
_bStart := _bPending AND NOT _fbWrite.BUSY AND NOT _bStart;
IF _bStart THEN
	_bPending := FALSE;
END_IF
_fbWrite(NETID := '', PORT := TwinCAT_SystemInfoVarList._AppInfo.AdsPort, START := _bStart, TMOUT := T#5S);
_ftBusy(CLK := _fbWrite.BUSY);
IF _ftBusy.Q THEN
	q_bError	:= _fbWrite.ERR;
	q_nErrorId	:= _fbWrite.ERRID;
	IF NOT _fbWrite.ERR THEN
		q_nSaveCount := q_nSaveCount + 1;
	END_IF
END_IF
q_bBusy := _fbWrite.BUSY;]]></ST>
    </Implementation>
    <Method Name="M_ChangedText" Id="{17e82eb9-09ff-480a-8333-aab3a542ad6a}">
      <Declaration><![CDATA[METHOD PRIVATE M_ChangedText : WSTRING(63)	// 바뀐 설정 비트 → 이름 (쉼표로 이음, 길면 잘림)
VAR_INPUT
	i_dwMask	: DWORD;
END_VAR
VAR
	i	: INT;
	sName	: WSTRING(31);
	sAll	: WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[sAll := "";
FOR i := 0 TO 17 DO
	IF (SHR(i_dwMask, i) AND 16#1) <> 0 THEN
		CASE i OF
			0:	sName := "운전 모드";
			1:	sName := "그룹 설정";
			2:	sName := "Manual 정책";
			3:	sName := "지령원 등록";
			4:	sName := "제한 등록";
			5:	sName := "기동 조건 등록";
			6:	sName := "보정 등록";
			8:	sName := "보호 규칙";
			9:	sName := "출력 규칙";
			10:	sName := "유닛 제한 등록";
			11:	sName := "버스 제한 등록";
			13:	sName := "명령 필터";
			14:	sName := "Manual 지령 거르기";
			15:	sName := "시퀀스";
			16:	sName := "모듈 설정";
			17:	sName := "브로커 감시";
		ELSE
			sName := "?";
		END_CASE
		IF sAll <> "" THEN
			sAll := WCONCAT(sAll, ", ");
		END_IF
		sAll := WCONCAT(sAll, sName);
	END_IF
END_FOR
M_ChangedText := sAll;]]></ST>
      </Implementation>
    </Method>
    <Action Name="A_CopyShadow" Id="{6a80c5dc-0941-4bc1-a7a8-44ebb22b1d21}">
      <Implementation>
        <ST><![CDATA[// 지난 스캔 사본 갱신
_aeOpMode		:= iq_aeOpMode;
_astGroupSet	:= iq_astGroupSet;
_astManualPolicy	:= iq_astManualPolicy;
_astSourceReg	:= iq_astSourceReg;
_astLimitReg	:= iq_astLimitReg;
_astPermitReg	:= iq_astPermitReg;
_astCompReg		:= iq_astCompReg;
_astRuleCfg		:= iq_astRuleCfg;
_astOutputCfg	:= iq_astOutputCfg;
_astUnitRuleReg	:= iq_astUnitRuleReg;
_astBatRuleReg	:= iq_astBatRuleReg;
_stCmdFilter	:= iq_stCmdFilter;
_stManualCmdSet	:= iq_stManualCmdSet;
_stSeqSet		:= iq_stSeqSet;
_stBrokerWatch	:= iq_stBrokerWatch;
IF i_pModuleSet <> 0 AND i_nModuleSetSize > 0 AND NOT q_bModuleSetTooBig THEN
	MEMCPY(ADR(_abModuleSet), i_pModuleSet, i_nModuleSetSize);
END_IF]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>