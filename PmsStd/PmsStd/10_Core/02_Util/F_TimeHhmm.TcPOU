<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_TimeHhmm" Id="{ccf8cc59-7ff6-4f0a-8a1a-e1857acc2a99}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_TimeHhmm : UINT		// 현지 시각 → HHMM (예: 13시 5분 = 1305)
VAR_INPUT
	i_stTime	: ST_LocalTime;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[F_TimeHhmm := i_stTime.nHour * 100 + i_stTime.nMinute;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>