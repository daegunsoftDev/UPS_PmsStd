<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="E_BatCmd" Id="{ba8da111-cca5-41fd-ac00-a0d5b96300c6}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_BatCmd :		// 배터리(BMS) 명령
(
	None		:= 0,
	Close		:= 1,	// DC 접촉기 투입
	Open		:= 2,	// DC 접촉기 개방
	EStop		:= 3,	// 비상정지 (보호)
	Reset		:= 4	// 고장 리셋
) INT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>