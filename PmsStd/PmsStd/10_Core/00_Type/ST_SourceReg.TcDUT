<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_SourceReg" Id="{77c04ef1-8f62-487b-8e6d-d60cca3f783c}">
    <Declaration><![CDATA[TYPE ST_SourceReg :
STRUCT
	bEnable		: BOOL;
	nGrade		: UINT := 9;			// 등급. 1이 가장 높음
	stStateMode	: ST_StateModeSet;					// 상태 요청을 명령마다 어느 운전 모드에서 받나 (기본 모두 Manual). 리셋은 모드와 관계없이 받음
	ePowerMode	: E_SourceMode := E_SourceMode.Auto;	// P·Q 지령과 P 제한을 받는 운전 모드
	nGroup		: UINT;					// 대상 제어 그룹. 0 = 모든 그룹
	tExpire		: TIME := T#10S;		// 이 시간 동안 새 값이 없으면 끊김
	bLostAlarm	: BOOL := TRUE;			// 끊기면 '지령원 끊김' 알람 (FB_EventLog). FALSE = 알람 안 냄 (끊김 처리는 그대로). [9번 수정 2026-11-09: 추가 — EMS는 브로커 끊김 알람으로 대신]
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>