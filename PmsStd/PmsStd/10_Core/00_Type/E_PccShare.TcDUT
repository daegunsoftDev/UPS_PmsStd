<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="E_PccShare" Id="{8ddbb596-6397-46b8-aef6-36043e1f1467}">
    <Declaration><![CDATA[{attribute 'strict'}
TYPE E_PccShare :		// 유닛(PCS) 단위 제어 모드가 보는 접속점 값 (여러 유닛이 한 접속점을 같이 쓸 때. 유닛이 혼자인 그룹은 셋 다 같음)
(
	ByRating	:= 0,	// 그룹 부하(그룹 유닛 출력 합 - 접속점 P)를 가용 정격 비율로 나눈 몫만 봄. 몫 합 = 그룹 부하 → 피크컷·역송 방지가 겹치지 않음 (목표 피크도 몫으로 넣음)
	Actual		:= 1,	// 접속점 실측 그대로 (다른 유닛 출력이 들어간 값). 유닛마다 같은 수전을 보고 따로 반응 (피크컷이 겹칠 수 있음)
	Fixed		:= 2	// 정한 비율(ST_CtrlModeSet.fPccRatio, 0~1)로 나눈 몫
) INT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>