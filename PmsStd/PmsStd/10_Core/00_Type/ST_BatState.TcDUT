<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_BatState" Id="{ef7ac908-2f95-4be1-8624-848d1a060038}">
    <Declaration><![CDATA[TYPE ST_BatState :
STRUCT
	bComm			: BOOL;
	bContactorClosed: BOOL;
	bWarn			: BOOL;
	bFault			: BOOL;
	bSysStop		: BOOL;		// 배터리가 스스로 정지 (운전 불가)
	stSoc			: ST_Val;	// %
	stSoh			: ST_Val;	// %
	fPChgMax		: REAL;		// kW, 충전 한도 (양수). bComm = FALSE면 0으로 본다
	fPDisMax		: REAL;		// kW, 방전 한도 (양수)
	bWriteFail		: BOOL;		// 장비 쓰기(명령)가 잇달아 실패함 (드라이버가 FB_DeviceBase.M_MarkWriteResult로 판단해 채움)
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>