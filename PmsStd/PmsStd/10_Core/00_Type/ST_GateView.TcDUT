	stManualCmdSet	: ST_ManualCmdSet;	// Manual 지령 거르기 설정 (GVL_PERSIST.g_stManualCmdSet, 코어 기본 Manual Gate가 씀)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
