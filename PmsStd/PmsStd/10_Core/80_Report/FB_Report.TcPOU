	iq_astBms		: ARRAY[1..GVL_PARAM.BMS_COUNT] OF ST_BatState;
	iq_astView		: ARRAY[1..GVL_PARAM.GROUP_COUNT] OF ST_GroupView;
	iq_astAutoPDiag	: ARRAY[1..GVL_PARAM.GROUP_COUNT] OF ST_OutputDiag;
	iq_aeUnitSeq	: ARRAY[1..GVL_PARAM.UNIT_COUNT] OF E_UnitSeq;
	iq_astWritten	: ARRAY[1..GVL_PARAM.UNIT_COUNT] OF ST_PQ;
END_VAR
(* 출력: 인터페이스 구조체가 정해지면 VAR_IN_OUT으로 받아서 채움 *)]]></Declaration>
