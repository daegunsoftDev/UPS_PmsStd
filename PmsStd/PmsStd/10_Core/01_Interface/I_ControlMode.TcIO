<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <Itf Name="I_ControlMode" Id="{ae9bdcea-6daa-446e-bd97-27891cad9c02}">
    <Declaration><![CDATA[INTERFACE I_ControlMode EXTENDS I_Module	// 제어 모드 하나 (피크 저감·FR·스케줄·정출력 등). FB_CtrlModeMgr가 한 번에 하나만 켬. 켜진 동안에만 M_Calc를 부름]]></Declaration>
    <Method Name="M_CheckEnter" Id="{282df795-b549-4530-8da8-dbb6ff203839}">
      <Declaration><![CDATA[METHOD M_CheckEnter : UINT		// 지금 진입해도 되나. 0 = 됨, 그 외 = 이유 코드 (M_ReasonText). 상태를 바꾸지 않음 (한 스캔에 여러 번 부를 수 있음)
VAR_INPUT
	i_stView	: ST_CtrlModeView;	// 그룹 값(stGroup)·현지 시각(stTime). 관리자가 매 스캔 채움
END_VAR]]></Declaration>
    </Method>
    <Method Name="M_Enter" Id="{6b2fedbb-1b67-4a67-91eb-935696861403}">
      <Declaration><![CDATA[METHOD M_Enter		// 켜질 때 한 번. 내부 상태(타이머·적분 등) 초기화
VAR_INPUT
	i_stView	: ST_CtrlModeView;	// 그룹 값(stGroup)·현지 시각(stTime). 관리자가 매 스캔 채움
END_VAR]]></Declaration>
    </Method>
    <Method Name="M_Calc" Id="{bff062b4-3bb4-4cec-8466-a62e20c79607}">
      <Declaration><![CDATA[METHOD M_Calc : ST_CtrlModeOut		// 켜져 있는 동안 매 스캔 한 번. 스스로 끝낼 때(bExitReq)도 그 스캔의 P·Q는 그대로 냄 (관리자가 0으로 넘김)
VAR_INPUT
	i_stView	: ST_CtrlModeView;	// 그룹 값(stGroup)·현지 시각(stTime). 관리자가 매 스캔 채움
END_VAR]]></Declaration>
    </Method>
    <Method Name="M_Exit" Id="{1248b166-5f14-434e-9291-967625fabdd8}">
      <Declaration><![CDATA[METHOD M_Exit		// 꺼질 때 한 번 (요청으로 바뀌든 스스로 끝내든)]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>