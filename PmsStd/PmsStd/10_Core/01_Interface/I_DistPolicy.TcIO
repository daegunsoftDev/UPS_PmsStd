<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <Itf Name="I_DistPolicy" Id="{cf70968c-a641-4aa7-834b-c2ed5add5711}">
    <Declaration><![CDATA[INTERFACE I_DistPolicy EXTENDS I_Module	// 분배 정책: 그룹 몫을 유닛에 나눌 무게. 그룹마다 한 칸 (GVL_SITE.g_aipDistPolicy), 비우면 코어 기본 FB_DistStd]]></Declaration>
    <Method Name="M_Weight" Id="{39dee0c3-8b8f-4479-9c76-239a081243de}">
      <Declaration><![CDATA[METHOD M_Weight : REAL		// 이 유닛의 무게 (0 이상, 클수록 많이). 0 = 이 유닛에 안 줌. 같은 입력이면 같은 결과 (한 스캔에 여러 번 부름)
VAR_INPUT
	i_stView	: ST_DistView;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>