<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_BatRank" Id="{81625599-5b38-4f12-aa20-09a503463dc1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_BatRank : INT		// 조치 세기: None 0 < Stop 1 < EStop 2
VAR_INPUT
	i_eAction	: E_BatAction;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE i_eAction OF
	E_BatAction.Stop:	F_BatRank := 1;
	E_BatAction.EStop:	F_BatRank := 2;
ELSE
	F_BatRank := 0;
END_CASE]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>