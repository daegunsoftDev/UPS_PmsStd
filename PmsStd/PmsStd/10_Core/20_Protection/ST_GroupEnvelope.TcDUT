<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_GroupEnvelope" Id="{a914dd0b-8ae9-4e88-806a-cd2c64c3a871}">
    <Declaration><![CDATA[TYPE ST_GroupEnvelope :	// 제어 그룹 설비 범위 (가용 유닛 기준). 성형의 설비 제한 줄 (정격·배터리)
STRUCT
	stRating	: ST_Range;	// kW, 가용 유닛 P 한도 합 (정격 × Derate ∩ 유닛 제한 모듈)
	stBattery	: ST_Range;	// kW, 버스마다 min(버스 한도, 그 버스 가용 유닛 한도 합) + 배터리 없는 유닛 한도
	stQ	: ST_Range;	// kvar, 가용 유닛 Q 한도 합
	fSMax	: REAL;	// kVA, 가용 유닛 피상전력 한도 합 (유닛 한도 = MIN(정격 S, √(보호 P 상한² + 보호 Q 상한²)))
	bResume	: BOOL;	// 유닛·버스 제한 모듈이 재개 중 (재개 램프율)
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>