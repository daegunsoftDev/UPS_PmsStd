<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_PcsCmdAllowed" Id="{3deff7d7-1551-4ebf-b8d3-10bc359fe497}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_PcsCmdAllowed : BOOL		// 지령원의 PCS 요청을 이 운전 모드에서 받나 (명령마다 등록값). 리셋은 항상 받음
VAR_INPUT
	i_stSet		: ST_PcsCmdMode;
	i_eCmd		: E_PcsCmd;
	i_eOpMode	: E_OpMode;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE i_eCmd OF
	E_PcsCmd.Run:		F_PcsCmdAllowed := F_SourceAllowed(i_stSet.eRun, i_eOpMode);
	E_PcsCmd.Standby:	F_PcsCmdAllowed := F_SourceAllowed(i_stSet.eStandby, i_eOpMode);
	E_PcsCmd.Stop:		F_PcsCmdAllowed := F_SourceAllowed(i_stSet.eStop, i_eOpMode);
	E_PcsCmd.EStop:		F_PcsCmdAllowed := F_SourceAllowed(i_stSet.eEStop, i_eOpMode);
	E_PcsCmd.Reset:		F_PcsCmdAllowed := TRUE;
ELSE
	F_PcsCmdAllowed := FALSE;		// None
END_CASE]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>